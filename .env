# Web service — local development.
#
# Only NUXT_* variables belong here. The API's secrets live in backend/.env and
# this service has no use for them: anything prefixed NUXT_PUBLIC_ is compiled
# into the browser bundle, so a secret placed here would ship to every reader.

# Where the browser and the SSR renderer reach the API.
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Server-only. Lets SSR reach the API over an internal network while the
# browser keeps using the public URL above. Unset means "use NUXT_PUBLIC_API_BASE".
# NUXT_API_INTERNAL_BASE=http://api:8080
