{"file":"index-CEnW5ZPI.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;AAcA,UAAM,MAAM,YAAA;AACZ,UAAM,EAAE,GAAG,OAAA,IAAW,eAAA;AACtB,UAAM,EAAE,SAAA,IAAa,UAAA;AAgBrB,UAAM,QAAQ,IAAe,EAAE;AAC/B,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,SAAS,IAAI,EAAE;AAErB,UAAM,eAAe,IAAoB,IAAI;AAC7C,UAAM,WAAW,IAAI,KAAK;AAEZ,aAAA;AAEd,aAAS,MAAM,MAAe;AAC5B,aAAO,OAAO,UAAU,QAAQ,KAAK,UAAU,KAAK,UAAU,KAAK;AAAA,IACrE;AAEA,mBAAe,OAAO;AACpB,cAAQ,QAAQ;AAChB,mBAAa,QAAQ;AACrB,UAAI;AACF,cAAM,QAAQ,MAAM,IAAI,IAAe,kBAAkB;AAAA,MAC3D,SAAS,GAAY;AACnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,iBAAiB;AAAA,MAClG,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAQA,mBAAe,gBAAgB;AAC7B,YAAM,SAAS,aAAa;AAC5B,UAAI,CAAC,OAAQ;AACb,eAAS,QAAQ;AACjB,mBAAa,QAAQ;AACrB,UAAI;AAEF,cAAM,IAAI,IAAI,oBAAoB,OAAO,EAAE,oBAAoB;AAC/D,qBAAa,QAAQ;AACrB,eAAO,QAAQ,EAAE,OAAO;AACxB,cAAM,KAAA;AAAA,MACR,SAAS,GAAY;AAGnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,kBAAkB;AACjG,qBAAa,QAAQ;AAAA,MACvB,UAAA;AACE,iBAAS,QAAQ;AAAA,MACnB;AAAA,IACF;AAEA,YAAQ,EAAE,OAAO,GAAG,EAAE,UAAU,CAAC,gBAAgB;;;;mBAI1CA,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,wHAGiBC,MAAA,CAAA,EAAC,UAAA,CAAA,yEACkBA,MAAA,CAAA,EAAC,YAAA,CAAA;;QAGrD,IAAG;AAAA,QACH,OAAM;AAAA,MAAA;yBAFR,CAGgC,GAAAC,QAAAC,UAAA,aAAA;;uCAA1BF,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,EAAA;AAAA;;cAANG,gBAAA,uBAAKH,MAAA,CAAA,EAAC,SAAA,CAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;;UAGAA,MAAA,MAAA,GAAM;iHAAmFA,MAAA,MAAA,CAAM,CAAA,MAAA;AAAA;;;UAC/FA,MAAA,YAAA,GAAY;kHAAoFA,MAAA,YAAA,CAAY,CAAA,MAAA;AAAA;;;UAE5GA,MAAA,OAAA,GAAO;oFAAsDA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA,MACxD,WAAA,CAAAA,MAAA,KAAA,EAAM,QAAM;uFAAyDA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA;;AAKhEI,sBAAAJ,MAAA,KAAA,IAAR,SAAI;;;YAMI,IAAE,gBAAkB,KAAK,EAAE;AAAA,YAAI,OAAM;AAAA,UAAA;6BAAhD,CAA+F,GAAAC,QAAAC,UAAA,aAAA;;AAAzBD,uBAAA,GAAAI,eAAA,MAAM,IAAI,CAAA,CAAA,EAAA;AAAA;;kBAAVF,gBAAAG,gBAAA,MAAM,IAAI,CAAA,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;AACpE,cAAA,KAAK,UAAQ;qHACpBN,MAAA,CAAA,EAAC,UAAA,CAAA,CAAA,SAAA;AAAA;;;AAEO,cAAA,CAAA,KAAK,aAAW;0GACxBA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,SAAA;AAAA;;;;;YAGuF,KAAK,aAAU,+BAAA;AAAA,UAAA,OAIxGK,eAAA,KAAK,aAAaL,MAAA,CAAA,kBAAkBA,MAAA,CAAA,EAAC,kBAAA,CAAA,mHAIbK,eAAA,KAAK,IAAI,mBAC1BA,eAAA,KAAK,eAAeL,MAAA,CAAA,gBAAgBA,MAAA,CAAA,EAAC,WAAA,CAAA,kCACrCA,MAAA,CAAA,EAAC,WAAA,EAAA,GAAiB,KAAK,SAAO,CAAA,kCAC9BA,MAAA,QAAA,EAAS,KAAK,SAAS,CAAA;AAM5B,cAAA,KAAK,aAAW;qCACrB,QAAI,IAAM,KAAK,IAAI,EAAA,qHAElBA,MAAA,CAAA,EAAC,UAAA,CAAA;;;;;YAEF,IAAE,gBAAkB,KAAK,EAAE;AAAA,YAC5B,OAAM;AAAA,UAAA;6BAFR,CAG2B,GAAAC,QAAAC,UAAA,aAAA;;yCAAvBF,MAAA,CAAA,EAAC,MAAA,CAAA,CAAA,EAAA;AAAA;;kDAADA,MAAA,CAAA,EAAC,MAAA,CAAA,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;6HAKDA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,sBAAA;AAAA;;;;QAUV,QAAQA,MAAA,YAAA;AAAA,QACR,OAAOA,MAAA,CAAA,EAAC,iBAAA;AAAA,QACR,SAASA,MAAA,YAAA,IAAeA,SAAC,qBAAA,EAAA,MAA8B,MAAMA,MAAA,YAAA,CAAY,EAAA,CAAA,IAAA;AAAA,QACzE,gBAAcA,qBAAc,WAAWA,MAAA,YAAA,EAAa,OAAO;AAAA,QAC3D,cAAcA,MAAA,YAAA,GAAc,WAAoB,CAAAA,MAAA,CAAA,4BAA4BA,MAAA,CAAA,EAAC,yBAAA,CAAA;QAG7E,iBAAeA,MAAA,CAAA,EAAC,QAAA;AAAA,QAChB,gBAAcA,MAAA,CAAA,EAAC,QAAA;AAAA,QACf,MAAMA,MAAA,QAAA;AAAA,QACN,WAAS;AAAA,QACT,sBAAQ,aAAA,QAAY;AAAA,MAAA;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent","_createTextVNode","_ssrRenderList","_ssrInterpolate","_toDisplayString"],"sources":["../../../../pages/admin/pages/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/**\n * Standalone pages: the policies, About and Contact (§93).\n *\n * These were Vue files until now, which meant a wording change in the privacy\n * policy needed a developer and a deploy.\n *\n * Deleting a required page is allowed but deliberately harder: search engines\n * already know /privacy, so a delete leaves a 404 there, while unpublishing\n * achieves the same visible result reversibly. The dialog says so and asks the\n * operator to type the address, and the API refuses without an explicit confirm.\n */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst api = useAdminApi()\nconst { t, locale } = useAdminLocale()\nconst { dateTime } = useFormat()\n\ninterface PageRow {\n  id: number\n  slug: string\n  titleKh: string\n  titleEn?: string\n  isPublished: boolean\n  showInFooter: boolean\n  isSystem: boolean\n  position: number\n  hasEnglish: boolean\n  wordsKh: number\n  updatedAt: string\n}\n\nconst pages = ref<PageRow[]>([])\nconst loading = ref(true)\nconst errorMessage = ref('')\nconst notice = ref('')\n\nconst deleteTarget = ref<PageRow | null>(null)\nconst deleting = ref(false)\n\nconst route = useRoute()\n\nfunction title(page: PageRow) {\n  return locale.value === 'en' && page.titleEn ? page.titleEn : page.titleKh\n}\n\nasync function load() {\n  loading.value = true\n  errorMessage.value = ''\n  try {\n    pages.value = await api.get<PageRow[]>('/api/admin/pages')\n  } catch (e: unknown) {\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('pagesLoadFailed')\n  } finally {\n    loading.value = false\n  }\n}\nonMounted(load)\n\n// The editor route redirects back here with its confirmation.\nonMounted(() => {\n  if (route.query.saved) notice.value = String(route.query.saved)\n})\n\nasync function confirmDelete() {\n  const target = deleteTarget.value\n  if (!target) return\n  deleting.value = true\n  errorMessage.value = ''\n  try {\n    // The API requires this for a required page, and ignores it otherwise.\n    await api.del(`/api/admin/pages/${target.id}?confirm=permanent`)\n    deleteTarget.value = null\n    notice.value = t('saved')\n    await load()\n  } catch (e: unknown) {\n    // The API refuses to delete a required page and explains why; that message\n    // is more useful than anything generic.\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('pageDeleteFailed')\n    deleteTarget.value = null\n  } finally {\n    deleting.value = false\n  }\n}\n\nuseHead({ title: `${t('pagesNav')} · CFN Admin` })\n</script>\n\n<template>\n  <div class=\"space-y-6\">\n    <header class=\"flex flex-wrap items-start justify-between gap-3\">\n      <div>\n        <h1 class=\"text-xl font-bold\">{{ t('pagesNav') }}</h1>\n        <p class=\"mt-1 max-w-2xl text-sm text-ink-muted\">{{ t('pagesIntro') }}</p>\n      </div>\n      <NuxtLink\n        to=\"/admin/pages/new\"\n        class=\"rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-dark\"\n      >+ {{ t('newPage') }}</NuxtLink>\n    </header>\n\n    <p v-if=\"notice\" role=\"status\" class=\"rounded-lg bg-success/10 px-4 py-3 text-sm text-success\">{{ notice }}</p>\n    <p v-if=\"errorMessage\" role=\"alert\" class=\"rounded-lg bg-breaking/10 px-4 py-3 text-sm text-breaking\">{{ errorMessage }}</p>\n\n    <p v-if=\"loading\" class=\"py-12 text-center text-sm text-ink-muted\">{{ t('loading') }}</p>\n    <p v-else-if=\"!pages.length\" class=\"card p-8 text-center text-sm text-ink-muted\">{{ t('noPages') }}</p>\n\n    <div v-else class=\"card overflow-hidden\">\n      <ul class=\"divide-y divide-line\">\n        <li\n          v-for=\"page in pages\"\n          :key=\"page.id\"\n          class=\"flex flex-wrap items-start gap-3 p-4 hover:bg-surface-muted\"\n        >\n          <div class=\"min-w-0 flex-1\">\n            <p class=\"flex flex-wrap items-center gap-2 text-kh-sm font-semibold\">\n              <NuxtLink :to=\"`/admin/pages/${page.id}`\" class=\"hover:text-brand\">{{ title(page) }}</NuxtLink>\n              <span v-if=\"page.isSystem\" class=\"rounded bg-ink/10 px-1.5 py-0.5 text-xs font-normal text-ink-muted\">\n                {{ t('required') }}\n              </span>\n              <span v-if=\"!page.isPublished\" class=\"rounded bg-warning/15 px-1.5 py-0.5 text-xs font-normal\">\n                {{ t('hidden') }}\n              </span>\n              <span\n                :class=\"[\n                  'rounded px-1.5 py-0.5 text-xs font-normal',\n                  page.hasEnglish ? 'bg-success/10 text-success' : 'bg-surface-muted text-ink-muted',\n                ]\"\n              >{{ page.hasEnglish ? t('translated') : t('noTranslationYet') }}</span>\n            </p>\n\n            <div class=\"mt-1 flex flex-wrap items-center gap-2 text-xs text-ink-muted\">\n              <code class=\"font-mono\">/{{ page.slug }}</code>\n              <span>· {{ page.showInFooter ? t('inFooter') : t('notInMenu') }}</span>\n              <span>· {{ t('wordsKh', { n: page.wordsKh }) }}</span>\n              <span>· {{ dateTime(page.updatedAt) }}</span>\n            </div>\n          </div>\n\n          <div class=\"flex shrink-0 items-center gap-1\">\n            <a\n              v-if=\"page.isPublished\"\n              :href=\"`/${page.slug}`\" target=\"_blank\" rel=\"noopener\"\n              class=\"rounded px-2 py-1 text-sm text-ink-muted hover:text-brand\"\n            >{{ t('viewPage') }}</a>\n            <NuxtLink\n              :to=\"`/admin/pages/${page.id}`\"\n              class=\"rounded-lg border border-line px-3 py-1 text-sm font-semibold hover:bg-surface\"\n            >{{ t('edit') }}</NuxtLink>\n            <button\n              type=\"button\"\n              class=\"rounded px-2 py-1 text-sm text-breaking hover:bg-breaking/10\"\n              @click=\"deleteTarget = page\"\n            >{{ t('remove') }}</button>\n          </div>\n        </li>\n      </ul>\n    </div>\n\n    <!-- requireText only for a required page: typing the address is a\n         proportionate speed bump there, and busywork for a page somebody added\n         themselves five minutes ago. -->\n    <ConfirmDialog\n      :open=\"!!deleteTarget\"\n      :title=\"t('deletePageTitle')\"\n      :message=\"deleteTarget ? t('deletePageMessage', { name: title(deleteTarget) }) : ''\"\n      :require-text=\"deleteTarget?.isSystem ? deleteTarget.slug : undefined\"\n      :consequences=\"deleteTarget?.isSystem\n        ? [t('deleteRequiredWarning'), t('deleteRequiredUnpublish')]\n        : []\"\n      :confirm-label=\"t('remove')\"\n      :cancel-label=\"t('cancel')\"\n      :busy=\"deleting\"\n      @confirm=\"confirmDelete\"\n      @cancel=\"deleteTarget = null\"\n    />\n  </div>\n</template>\n"],"version":3}