{"file":"index-CQ7CIhhW.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqBA,UAAM,MAAM,YAAA;AACZ,UAAM,OAAO,aAAA;AACb,UAAM,EAAE,EAAA,IAAM,eAAA;AACd,UAAM,EAAE,SAAA,IAAa,UAAA;AAarB,UAAM,QAAQ,IAAY,EAAE;AAC5B,UAAM,SAAS,IAAuB,EAAE;AACxC,UAAM,QAAQ,IAAe,EAAE;AAC/B,UAAM,WAAW,IAAoB,IAAI;AACzC,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,SAAS,IAAI,EAAE;AACrB,UAAM,SAAS,IAAI,EAAE;AACrB,UAAM,MAAM,IAAwB,QAAQ;AAE5C,UAAM,oBAAoB,IAAoB,IAAI;AAClD,UAAM,OAAO,IAAI,KAAK;AAEtB,UAAM,eAAe,SAAS,MAAM,KAAK,IAAI,cAAc,CAAC;AAE5D,UAAM,OAAO,SAAS,MAAM;AAAA,MAC1B,EAAE,KAAK,UAAmB,OAAO,EAAE,QAAQ,EAAA;AAAA,MAC3C,EAAE,KAAK,SAAkB,OAAO,EAAE,qBAAqB,EAAA;AAAA,IAAE,CAC1D;AAED,UAAM,cAAc;AAAA,MAAS,MAC3B,MAAM,MAAM,IAAI,QAAM,EAAE,OAAO,EAAE,MAAM,OAAO,EAAE,MAAM,KAAK,EAAE,WAAW,EAAE,GAAG,EAAE,UAAA,CAAW,IAAI;AAAA,IAAA;AAGhG,mBAAe,OAAO;AACpB,cAAQ,QAAQ;AAChB,mBAAa,QAAQ;AACrB,UAAI;AACF,cAAM,CAAC,GAAG,GAAG,CAAC,IAAI,MAAM,QAAQ,IAAI;AAAA,UAClC,IAAI,IAAY,kBAAkB;AAAA,UAClC,IAAI,IAAuB,wBAAwB;AAAA,UACnD,IAAI,KAAgB,oBAAoB,EAAE,OAAO,KAAK,QAAQ,OAAO,SAAS,OAAA,CAAW;AAAA,QAAA,CAC1F;AACD,cAAM,QAAQ,KAAK,CAAA;AACnB,eAAO,QAAQ,KAAK,CAAA;AACpB,cAAM,QAAQ,EAAE,QAAQ,CAAA;AACxB,iBAAS,QAAQ,EAAE,QAAQ;AAAA,MAC7B,SAAS,GAAY;AACnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,iBAAiB;AAAA,MAClG,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAKc,aAAA;AAQd,mBAAe,QAAQ,MAAe,UAAkB;AACtD,UAAI,aAAa,KAAK,SAAU;AAChC,mBAAa,QAAQ;AACrB,aAAO,QAAQ;AACf,UAAI;AACF,cAAM,IAAI,IAAI,oBAAoB,KAAK,EAAE,SAAS,EAAE,UAAU;AAC9D,eAAO,QAAQ,GAAG,KAAK,IAAI,MAAM,MAAM,MAAM,KAAK,CAAA,MAAK,EAAE,SAAS,QAAQ,GAAG,QAAQ,QAAQ;AAC7F,cAAM,KAAA;AAAA,MACR,SAAS,GAAY;AAGnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,gBAAgB;AAC/F,cAAM,KAAA;AAAA,MACR;AAAA,IACF;AAEA,mBAAe,UAAU,MAAe,UAAmB;AACzD,mBAAa,QAAQ;AACrB,WAAK,QAAQ;AACb,UAAI;AACF,cAAM,IAAI,IAAI,oBAAoB,KAAK,EAAE,WAAW,EAAE,UAAU;AAChE,eAAO,QAAQ,GAAG,KAAK,IAAI,MAAM,WAAW,EAAE,eAAe,IAAI,EAAE,YAAY,CAAC;AAChF,0BAAkB,QAAQ;AAC1B,cAAM,KAAA;AAAA,MACR,SAAS,GAAY;AACnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,gBAAgB;AAAA,MACjG,UAAA;AACE,aAAK,QAAQ;AAAA,MACf;AAAA,IACF;AAEA,aAAS,gBAAgB,MAAY;AACnC,aAAO,KAAK,kBACR,EAAE,sBAAsB,IACxB,EAAE,oBAAoB,EAAE,GAAG,KAAK,YAAY,OAAA,CAAQ;AAAA,IAC1D;AAEA,YAAQ,EAAE,OAAO,GAAG,EAAE,aAAa,CAAC,gBAAgB;;;;;;+FAKVA,MAAA,CAAA,EAAC,aAAA,CAAA,2EACeA,MAAA,CAAA,EAAC,YAAA,CAAA;AAIpCC,oBAAAD,MAAA,IAAA,IAAR,SAAI;;;UAGgFA,MAAA,GAAA,MAAQ,KAAK,MAAG,qCAAA;AAAA,QAAA,OAKzGE,eAAA,KAAK,KAAK;;;UAGPF,MAAA,MAAA,GAAM;gHAAkFA,MAAA,MAAA,CAAM,CAAA,MAAA;AAAA;;;UAC9FA,MAAA,YAAA,GAAY;iHAAmFA,MAAA,YAAA,CAAY,CAAA,MAAA;AAAA;;;UAC3GA,MAAA,OAAA,GAAO;4EAA8CA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA,iBAG3CA,MAAA,GAAA,MAAG,UAAA;;;sBAEGA,MAAA,MAAA;AAAA,6DAAA,OAAM,QAAA,SAAA;AAAA,UAAG,aAAaA,MAAA,CAAA,EAAC,cAAA;AAAA,UAAmB,MAAMA,MAAA,OAAA;AAAA,UAAU,UAAQ;AAAA,UAAO,SAAO;AAAA,QAAA;;AAG9F,YAAA,CAAAA,MAAA,KAAA,EAAM,QAAM;iFAAiDA,MAAA,CAAA,EAAC,WAAA,CAAA,CAAA,MAAA;AAAA;;AAIjDC,wBAAAD,MAAA,KAAA,IAAR,SAAI;4MAER,KAAK,KAAK,MAAK,GAAA,CAAA,CAAA,iFAKbE,eAAA,KAAK,IAAI;AACA,gBAAA,KAAK,OAAOF,YAAK,MAAM,IAAE;4FAAqDA,MAAA,CAAA,EAAC,KAAA,CAAA,CAAA,SAAA;AAAA;;;oEAE/CE,eAAA,KAAK,KAAK,0CAEnDA,eAAAF,MAAA,CAAA,EAAC,oBAAA,EAAA,GAA0B,KAAK,YAAY,QAAM,CAAA;AACrC,gBAAA,KAAK,aAAW;iDAAQA,MAAA,CAAA,EAAC,cAAA,CAAA,oBAAuBA,MAAA,QAAA,EAAS,KAAK,WAAW,CAAA;;;;;;cAMxF,eAAa,KAAK;AAAA,cAClB,SAASA,MAAA,WAAA;AAAA,cACT,WAAW;AAAA,cACX,YAAY;AAAA,cACZ,UAAQ,CAAGA,MAAA,IAAA,EAAK,IAAG,cAAA;AAAA,cACnB,mCAAoB,QAAQ,MAAM,OAAO,MAAM,CAAA;AAAA,YAAA;;gBAK5CA,MAAA,IAAA,EAAK,IAAG,cAAA,KAAoB,KAAK,OAAOA,MAAA,IAAA,EAAK,MAAM,IAAE;gKAIzDA,MAAA,CAAA,EAAC,YAAA,CAAA,CAAA,WAAA;AAAA;;;;;;;;;;aAQDA,MAAA,YAAA,GAAY;0GACjBA,MAAA,CAAA,EAAC,eAAA,CAAA,CAAA,MAAA;AAAA;;;;AAMeC,sBAAAD,MAAA,KAAA,IAAR,SAAI;0LAMJE,eAAA,KAAK,IAAI,gEACkDA,eAAA,KAAK,IAAI;AAE/D,cAAA,KAAK,uBAAqB;0FAE/BC,cAAA,SAAOH,MAAA,CAAA,EAAC,gBAAA,CAAA,oBACPA,MAAA,CAAA,EAAC,YAAA,CAAA;;;;gEAEqCE,eAAA,KAAK,WAAW,+CAEvDA,eAAA,gBAAgB,IAAI,CAAA,sBAAUF,MAAA,CAAA,EAAC,WAAA,EAAA,GAAiB,KAAK,UAAA,CAAS,CAAA;cAO7DA,MAAA,YAAA,KAAY,CAAK,KAAK,iBAAe;;cAC1C,IAAE,gBAAkB,KAAK,EAAE;AAAA,cAC5B,OAAM;AAAA,YAAA;+BAHR,CAIsC,GAAAI,QAAAC,UAAA,aAAA;;2CAAlCL,MAAA,CAAA,EAAC,iBAAA,CAAA,CAAA,EAAA;AAAA;;oDAADA,MAAA,CAAA,EAAC,iBAAA,CAAA,GAAA,CAAA;AAAA,kBAAA;AAAA;;;;UACY,WAAA,KAAK,iBAAe;kFAChCA,MAAA,CAAA,EAAC,sBAAA,CAAA,CAAA,SAAA;AAAA;;;;;oGAOoBA,MAAA,CAAA,EAAC,qBAAA,CAAA,CAAA,sCAAA;AAERC,sBAAAD,MAAA,MAAA,IAAT,UAAK;AAC+D,gBAAA,mFAAAE,eAAA,MAAM,KAAK,CAAA,+CAAA;wBAEnE,MAAM,SAAO,CAAtB,UAAK;iHAC+BA,eAAA,MAAM,IAAI,wCACvBA,eAAA,MAAM,WAAW;;;;;;;QAS1D,QAAQF,MAAA,iBAAA;AAAA,QACR,OAAOA,MAAA,CAAA,EAAC,iBAAA;AAAA,QACR,SAASA,2BAAiB,GAAMA,MAAA,iBAAA,EAAkB,IAAI,KAAKA,MAAA,iBAAA,EAAkB,KAAK,MAAA;AAAA,QAClF,cAAY,CAAGA,MAAA,CAAA,EAAC,qBAAA,GAAyBA,MAAA,CAAA,wBAAwBA,MAAA,CAAA,EAAC,sBAAA,CAAA;AAAA,QAClE,iBAAeA,MAAA,CAAA,EAAC,YAAA;AAAA,QAChB,gBAAcA,MAAA,CAAA,EAAC,QAAA;AAAA,QACf,MAAMA,MAAA,IAAA;AAAA,QACN,WAAO,CAAA,WAAEA,MAAA,iBAAA,KAAqB,UAAUA,MAAA,iBAAA,GAAiB,KAAA;AAAA,QACzD,sBAAQ,kBAAA,QAAiB;AAAA,MAAA;;;;;;;;;;;","names":["_unref","_ssrRenderList","_ssrInterpolate","_ssrRenderAttr","_push","_parent"],"sources":["../../../../pages/admin/roles/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { ApiMeta } from '~/types'\nimport type { UserRef } from '~/types/admin'\n\n/**\n * Access control (§66, §67): who holds which role, and what each role can do.\n *\n * Two writes with deliberately different gates. Assigning a role to a person is\n * routine, so it needs users.manage. Editing what a role can *do* is the one\n * action that can hand out every other action, so it needs roles.manage — which\n * only Super Admin holds.\n *\n * Editing a role's permissions is its own route (/admin/roles/[id]) rather than\n * a panel here. A permission grid is long, it is worth a browser-history entry\n * and a link somebody can be sent, and mixing it into this page meant the list\n * you were comparing against scrolled away while you worked.\n *\n * The API enforces all of this again; nothing here is load-bearing for security.\n */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst api = useAdminApi()\nconst auth = useAuthStore()\nconst { t } = useAdminLocale()\nconst { dateTime } = useFormat()\n\ninterface Role {\n  id: number; slug: string; name: string; description: string\n  isSystem: boolean; userCount: number\n  permissions: string[]; holdsEverything: boolean\n  permissionsCustomised: boolean\n}\ninterface PermissionGroup {\n  group: string\n  entries: { name: string; description: string }[]\n}\n\nconst roles = ref<Role[]>([])\nconst groups = ref<PermissionGroup[]>([])\nconst users = ref<UserRef[]>([])\nconst userMeta = ref<ApiMeta | null>(null)\nconst loading = ref(true)\nconst errorMessage = ref('')\nconst notice = ref('')\nconst search = ref('')\nconst tab = ref<'people' | 'roles'>('people')\n\nconst pendingDeactivate = ref<UserRef | null>(null)\nconst busy = ref(false)\n\nconst canEditRoles = computed(() => auth.can('roles.manage'))\n\nconst tabs = computed(() => [\n  { key: 'people' as const, label: t('people') },\n  { key: 'roles' as const, label: t('rolesAndPermissions') },\n])\n\nconst roleOptions = computed(() =>\n  roles.value.map(r => ({ value: r.slug, label: r.name, sub: t('holders', { n: r.userCount }) })),\n)\n\nasync function load() {\n  loading.value = true\n  errorMessage.value = ''\n  try {\n    const [r, p, u] = await Promise.all([\n      api.get<Role[]>('/api/admin/roles'),\n      api.get<PermissionGroup[]>('/api/admin/permissions'),\n      api.list<UserRef[]>('/api/admin/users', { limit: 100, search: search.value || undefined }),\n    ])\n    roles.value = r ?? []\n    groups.value = p ?? []\n    users.value = u.data ?? []\n    userMeta.value = u.meta ?? null\n  } catch (e: unknown) {\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('rolesLoadFailed')\n  } finally {\n    loading.value = false\n  }\n}\nonMounted(load)\n\n// A role change made on the edit route comes back as a query flag, so the\n// confirmation lands on the list the operator returns to.\nconst route = useRoute()\nonMounted(() => {\n  if (route.query.saved) {\n    notice.value = String(route.query.saved)\n    tab.value = 'roles'\n  }\n})\n\nasync function setRole(user: UserRef, roleSlug: string) {\n  if (roleSlug === user.roleSlug) return\n  errorMessage.value = ''\n  notice.value = ''\n  try {\n    await api.put(`/api/admin/users/${user.id}/role`, { roleSlug })\n    notice.value = `${user.name} → ${roles.value.find(r => r.slug === roleSlug)?.name ?? roleSlug}`\n    await load()\n  } catch (e: unknown) {\n    // The API blocks removing the last Super Admin and granting Super Admin\n    // from a lesser role — show its reason, not a generic failure.\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('roleSaveFailed')\n    await load()\n  }\n}\n\nasync function setActive(user: UserRef, isActive: boolean) {\n  errorMessage.value = ''\n  busy.value = true\n  try {\n    await api.put(`/api/admin/users/${user.id}/active`, { isActive })\n    notice.value = `${user.name} — ${isActive ? t('activeSection') : t('deactivate')}`\n    pendingDeactivate.value = null\n    await load()\n  } catch (e: unknown) {\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('roleSaveFailed')\n  } finally {\n    busy.value = false\n  }\n}\n\nfunction permissionCount(role: Role) {\n  return role.holdsEverything\n    ? t('holdsEverythingShort')\n    : t('permissionsCount', { n: role.permissions.length })\n}\n\nuseHead({ title: `${t('rolesAccess')} · CFN Admin` })\n</script>\n\n<template>\n  <div>\n    <h1 class=\"mb-1 text-xl font-bold\">{{ t('rolesAccess') }}</h1>\n    <p class=\"mb-4 max-w-prose text-sm text-ink-muted\">{{ t('rolesIntro') }}</p>\n\n    <div class=\"mb-4 flex gap-2\">\n      <button\n        v-for=\"item in tabs\"\n        :key=\"item.key\"\n        type=\"button\"\n        :class=\"[\n          'rounded-full border px-4 py-1.5 text-sm transition-colors',\n          tab === item.key ? 'border-brand bg-brand text-white' : 'border-line hover:border-brand',\n        ]\"\n        @click=\"tab = item.key\"\n      >{{ item.label }}</button>\n    </div>\n\n    <p v-if=\"notice\" role=\"status\" class=\"mb-4 rounded-lg bg-success/10 p-3 text-sm text-success\">{{ notice }}</p>\n    <p v-if=\"errorMessage\" role=\"alert\" class=\"mb-4 rounded-lg bg-breaking/10 p-3 text-sm text-breaking\">{{ errorMessage }}</p>\n    <p v-if=\"loading\" class=\"py-12 text-center text-ink-muted\">{{ t('loading') }}</p>\n\n    <!-- ── People ────────────────────────────────────────────────────── -->\n    <section v-else-if=\"tab === 'people'\">\n      <div class=\"mb-4 max-w-md\">\n        <SearchInput v-model=\"search\" :placeholder=\"t('searchPeople')\" :busy=\"loading\" @search=\"load\" @clear=\"load\" />\n      </div>\n\n      <p v-if=\"!users.length\" class=\"card p-8 text-center text-ink-muted\">{{ t('noResults') }}</p>\n\n      <div v-else class=\"card overflow-hidden\">\n        <ul class=\"divide-y divide-line\">\n          <li v-for=\"user in users\" :key=\"user.id\" class=\"flex flex-wrap items-center gap-3 p-4\">\n            <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand/10 text-sm font-bold text-brand\">\n              {{ user.name.slice(0, 1) }}\n            </span>\n\n            <div class=\"min-w-0 flex-1\">\n              <p class=\"truncate text-sm font-semibold\">\n                {{ user.name }}\n                <span v-if=\"user.id === auth.user?.id\" class=\"ml-1 text-xs font-normal text-ink-muted\">{{ t('you') }}</span>\n              </p>\n              <p class=\"truncate text-xs text-ink-muted\">{{ user.email }}</p>\n              <p class=\"text-xs text-ink-muted\">\n                {{ t('permissionsCount', { n: user.permissions.length }) }}\n                <template v-if=\"user.lastLoginAt\"> · {{ t('lastSignedIn') }} {{ dateTime(user.lastLoginAt) }}</template>\n              </p>\n            </div>\n\n            <div class=\"w-52 shrink-0\">\n              <SearchableSelect\n                :model-value=\"user.roleSlug\"\n                :options=\"roleOptions\"\n                :clearable=\"false\"\n                :searchable=\"false\"\n                :disabled=\"!auth.can('users.manage')\"\n                @update:model-value=\"setRole(user, String($event))\"\n              />\n            </div>\n\n            <button\n              v-if=\"auth.can('users.manage') && user.id !== auth.user?.id\"\n              type=\"button\"\n              class=\"shrink-0 rounded border border-breaking px-2 py-1 text-xs text-breaking hover:bg-breaking/5\"\n              @click=\"pendingDeactivate = user\"\n            >{{ t('deactivate') }}</button>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- ── Roles list ────────────────────────────────────────────────── -->\n    <section v-else class=\"space-y-6\">\n      <p v-if=\"!canEditRoles\" class=\"rounded-lg bg-surface-muted px-4 py-3 text-sm text-ink-muted\">\n        {{ t('rolesReadOnly') }}\n      </p>\n\n      <div class=\"card overflow-hidden\">\n        <ul class=\"divide-y divide-line\">\n          <li\n            v-for=\"role in roles\"\n            :key=\"role.id\"\n            class=\"flex flex-wrap items-start gap-3 p-4 hover:bg-surface-muted\"\n          >\n            <div class=\"min-w-0 flex-1\">\n              <p class=\"flex flex-wrap items-center gap-2 text-sm font-semibold\">\n                {{ role.name }}\n                <code class=\"font-mono text-xs font-normal text-ink-muted\">{{ role.slug }}</code>\n                <span\n                  v-if=\"role.permissionsCustomised\"\n                  class=\"rounded bg-warning/15 px-1.5 py-0.5 text-xs font-normal\"\n                  :title=\"t('customisedHint')\"\n                >{{ t('customised') }}</span>\n              </p>\n              <p class=\"mt-0.5 text-xs text-ink-muted\">{{ role.description }}</p>\n              <p class=\"mt-1 text-xs text-ink-muted\">\n                {{ permissionCount(role) }} · {{ t('holders', { n: role.userCount }) }}\n              </p>\n            </div>\n\n            <!-- Super Admin is not linkable: its access is implicit, so the\n                 edit route has nothing to show and the API refuses it. -->\n            <NuxtLink\n              v-if=\"canEditRoles && !role.holdsEverything\"\n              :to=\"`/admin/roles/${role.id}`\"\n              class=\"shrink-0 rounded-lg border border-line px-3 py-1.5 text-xs font-semibold hover:bg-surface\"\n            >{{ t('editPermissions') }}</NuxtLink>\n            <span v-else-if=\"role.holdsEverything\" class=\"shrink-0 text-xs text-ink-muted\">\n              {{ t('holdsEverythingShort') }}\n            </span>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"card p-5\">\n        <h2 class=\"mb-3 font-bold\">{{ t('permissionCatalogue') }}</h2>\n        <div class=\"space-y-4\">\n          <div v-for=\"group in groups\" :key=\"group.group\">\n            <p class=\"mb-1.5 text-xs font-bold uppercase tracking-wide text-ink-muted\">{{ group.group }}</p>\n            <ul class=\"divide-y divide-line\">\n              <li v-for=\"entry in group.entries\" :key=\"entry.name\" class=\"flex flex-wrap gap-x-3 py-1.5 text-sm\">\n                <code class=\"shrink-0 text-xs text-brand\">{{ entry.name }}</code>\n                <span class=\"text-ink-muted\">{{ entry.description }}</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <ConfirmDialog\n      :open=\"!!pendingDeactivate\"\n      :title=\"t('deactivateTitle')\"\n      :message=\"pendingDeactivate ? `${pendingDeactivate.name} (${pendingDeactivate.email})` : ''\"\n      :consequences=\"[t('deactivateSignedOut'), t('deactivateBylines'), t('deactivateReversible')]\"\n      :confirm-label=\"t('deactivate')\"\n      :cancel-label=\"t('cancel')\"\n      :busy=\"busy\"\n      @confirm=\"pendingDeactivate && setActive(pendingDeactivate, false)\"\n      @cancel=\"pendingDeactivate = null\"\n    />\n  </div>\n</template>\n"],"version":3}