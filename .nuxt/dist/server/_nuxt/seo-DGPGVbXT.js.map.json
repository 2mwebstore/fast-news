{"file":"seo-DGPGVbXT.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;AAIA,UAAM,EAAE,EAAA,IAAM,eAAA;AAEF,gBAAA;AAYZ,UAAM,SAAS,IAAmB,IAAI;AACtC,UAAM,UAAU,IAAI,IAAI;AAUxB,YAAQ,EAAE,OAAO,yBAAyB;;;;;UAM7BA,MAAA,MAAA,GAAM;AAAqD,cAAA,sDAAAC,eAAAD,MAAA,MAAA,EAAO,IAAI,CAAA,MAAA;AAAA;;;UAEtEA,MAAA,OAAA,GAAO;4EAA8CA,MAAA,CAAA,EAAC,UAAA,CAAA,CAAA,MAAA;AAAA,iBAE/CA,MAAA,MAAA,GAAM;;;UAEN,OAAOA,MAAA,CAAA,EAAC,mBAAA;AAAA,UAAwB,OAAOA,MAAA,MAAA,EAAO;AAAA,QAAA;;UAC/C,OAAM;AAAA,UAAW,OAAOA,MAAA,MAAA,EAAO,YAAS,MAAA;AAAA,UAAe,QAAQA,MAAA,MAAA,EAAO,YAAS,YAAA;AAAA,QAAA;;UAC9E,OAAOA,MAAA,CAAA,EAAC,gBAAA;AAAA,UAAqB,OAAOA,MAAA,MAAA,EAAO;AAAA,QAAA;;UAC5C,OAAM;AAAA,UAAc,OAAOA,MAAA,MAAA,EAAO,WAAQ,MAAA;AAAA,UAAe,QAAQA,MAAA,MAAA,EAAO,WAAQ,YAAA;AAAA,QAAA;yHAIdA,MAAA,CAAA,EAAC,aAAA,CAAA,CAAA,OAAA;aAEpEA,MAAA,MAAA,EAAO,OAAO,QAAM;+EACzBA,MAAA,CAAA,EAAC,UAAA,CAAA,CAAA,MAAA;AAAA;;wBAIgBA,MAAA,MAAA,EAAO,QAAM,CAAtB,UAAK;;;cAGuF,MAAM,aAAQ,UAAA,iCAAA;AAAA,YAAA,OAI7GC,eAAA,MAAM,QAAQ,uCACaA,eAAA,MAAM,KAAK,qEACmBA,eAAA,MAAM,KAAK;gBAGhE,MAAM,SAAS,QAAM;;4BACR,MAAM,SAAO,CAAvB,WAAM;;;kBACJ,IAAE,eAAiB,OAAO,EAAE;AAAA,kBAAS,OAAM;AAAA,gBAAA;mCAAtD,CAEW,GAAAC,QAAAC,UAAA,aAAA;;AADND,6BAAA,GAAAD,eAAA,OAAO,OAAO,CAAA,EAAA;AAAA;;wBAAdG,gBAAAC,gBAAA,OAAO,OAAO,GAAA,CAAA;AAAA,sBAAA;AAAA;;;;;;;;;;;;;;gKAUeL,MAAA,CAAA,EAAC,kBAAA,CAAA,2EAElCA,MAAA,CAAA,EAAC,cAAA,CAAA,4BACDA,MAAA,CAAA,EAAC,WAAA,CAAA,4BACDA,MAAA,CAAA,EAAC,WAAA,CAAA,sDACDA,MAAA,CAAA,EAAC,WAAA,CAAA,2DACDA,MAAA,CAAA,EAAC,aAAA,CAAA,4BACDA,MAAA,CAAA,EAAC,QAAA,CAAA,4BACDA,MAAA,CAAA,EAAC,eAAA,CAAA,4BACDA,MAAA,CAAA,EAAC,YAAA,CAAA;;;;;;;;;;;;;;","names":["_unref","_ssrInterpolate","_push","_parent","_createTextVNode","_toDisplayString"],"sources":["../../../../pages/admin/seo.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/** SEO health dashboard (§60, §89). */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst { t } = useAdminLocale()\n\nconst api = useAdminApi()\n\ninterface Issue {\n  key: string; label: string; severity: 'warning' | 'error'\n  count: number\n  samples?: { id: number; slug: string; titleKh: string }[]\n}\ninterface Report {\n  publishedArticles: number; sitemapOk: boolean; newsSitemapOk: boolean\n  robotsOk: boolean; newsSitemapCount: number; issues: Issue[]; note: string\n}\n\nconst report = ref<Report | null>(null)\nconst loading = ref(true)\n\nonMounted(async () => {\n  try {\n    report.value = await api.get<Report>('/api/admin/seo/health')\n  } finally {\n    loading.value = false\n  }\n})\n\nuseHead({ title: 'SEO health — Newsroom' })\n</script>\n\n<template>\n  <div>\n    <h1 class=\"mb-1 text-xl font-bold\">SEO Health</h1>\n    <p v-if=\"report\" class=\"mb-4 max-w-prose text-sm text-ink-muted\">{{ report.note }}</p>\n\n    <p v-if=\"loading\" class=\"py-12 text-center text-ink-muted\">{{ t('checking') }}</p>\n\n    <div v-else-if=\"report\" class=\"space-y-6\">\n      <div class=\"grid gap-3 sm:grid-cols-4\">\n        <AdminStat :label=\"t('publishedArticles')\" :value=\"report.publishedArticles\" />\n        <AdminStat label=\"Sitemap\" :value=\"report.sitemapOk ? '✓' : '—'\" :accent=\"report.sitemapOk ? 'success' : 'warning'\" />\n        <AdminStat :label=\"t('newsSitemap48h')\" :value=\"report.newsSitemapCount\" />\n        <AdminStat label=\"robots.txt\" :value=\"report.robotsOk ? '✓' : '—'\" :accent=\"report.robotsOk ? 'success' : 'warning'\" />\n      </div>\n\n      <section>\n        <h2 class=\"mb-3 text-sm font-bold uppercase tracking-wide text-ink-muted\">{{ t('issuesFound') }}</h2>\n\n        <p v-if=\"!report.issues.length\" class=\"card p-6 text-center text-success\">\n          {{ t('noIssues') }}\n        </p>\n\n        <ul v-else class=\"space-y-3\">\n          <li v-for=\"issue in report.issues\" :key=\"issue.key\" class=\"card p-4\">\n            <div class=\"flex items-center gap-2\">\n              <span\n                :class=\"[\n                  'rounded px-2 py-0.5 text-xs font-bold uppercase',\n                  issue.severity === 'error' ? 'bg-breaking/15 text-breaking' : 'bg-warning/15 text-warning',\n                ]\"\n              >{{ issue.severity }}</span>\n              <span class=\"font-semibold\">{{ issue.label }}</span>\n              <span class=\"ml-auto text-lg font-extrabold tabular-nums\">{{ issue.count }}</span>\n            </div>\n\n            <ul v-if=\"issue.samples?.length\" class=\"mt-3 space-y-1 border-t border-line pt-3\">\n              <li v-for=\"sample in issue.samples\" :key=\"sample.id\">\n                <NuxtLink :to=\"`/admin/news/${sample.id}/edit`\" class=\"block truncate text-kh-sm text-brand hover:underline\">\n                  {{ sample.titleKh }}\n                </NuxtLink>\n              </li>\n            </ul>\n          </li>\n        </ul>\n      </section>\n\n      <section class=\"card p-5\">\n        <h2 class=\"mb-2 font-bold\">Google Search Console</h2>\n        <p class=\"mb-3 text-sm text-ink-muted\">{{ t('afterLaunchSteps') }}</p>\n        <ol class=\"list-decimal space-y-1 pl-5 text-sm\">\n          <li>{{ t('gscAddDomain') }}</li>\n          <li>{{ t('gscVerify') }}</li>\n          <li>{{ t('gscSubmit') }} <code>/sitemap.xml</code></li>\n          <li>{{ t('gscSubmit') }} <code>/news-sitemap.xml</code></li>\n          <li>{{ t('gscIndexing') }}</li>\n          <li>{{ t('gscCwv') }}</li>\n          <li>{{ t('gscStructured') }}</li>\n          <li>{{ t('gscQueries') }}</li>\n        </ol>\n      </section>\n    </div>\n  </div>\n</template>\n"],"version":3}