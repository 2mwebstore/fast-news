{"file":"live-CgdOGVNz.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAKA,UAAM,EAAE,EAAA,IAAM,UAAA;AACd,UAAM,EAAE,MAAM,aAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,YAA2B,aAAa,aAAa,EAAE,OAAO,GAAA,CAAI,CAAA;AAElG,UAAM,QAAQ,iBAAA;AACd,UAAM,EAAE,UAAA,IAAc,kBAAA;AACtB,UAAM,EAAE,MAAM,WAAA,IAAe,UAAA;AAI7B,UAAM,QAAQ,SAAS,MAAM;AAC3B,YAAM,2BAAW,IAAA;AACjB,YAAM,MAAqB,CAAA;AAC3B,iBAAW,WAAW,CAAC,GAAG,MAAM,OAAO,GAAI,QAAQ,SAAS,CAAA,CAAG,GAAG;AAChE,YAAI,KAAK,IAAI,QAAQ,EAAE,EAAG;AAC1B,aAAK,IAAI,QAAQ,EAAE;AACnB,YAAI,KAAK,OAAO;AAAA,MAClB;AACA,aAAO;AAAA,IACT,CAAC;AAED,eAAW;AAAA,MACT,OAAO,GAAG,EAAE,MAAM,CAAC;AAAA,MACnB,aAAa,EAAE,UAAU;AAAA,MACzB,MAAM;AAAA,IAAA,CACP;;;;;;;mBAIMC,eAAAC,WAAA,EAAA,OAAM,oBAAA,GAAmB,MAAA,CAAA,wRAIrBC,MAAA,CAAA,EAAC,MAAA,CAAA;;QAKoFA,MAAA,SAAA,IAAS,+BAAA;AAAA,MAAA,sBAK9FA,MAAA,SAAA,IAAYA,MAAA,CAAA,EAAC,cAAA,IAAmBA,MAAA,CAAA,EAAC,sBAAA,CAAA;AAShBC,oBAAAD,MAAA,KAAA,IAAX,YAAO;;;UAKmG,QAAQ,aAAU,gBAAA;AAAA,QAAA;AAUvH,YAAA,QAAQ,aAAW;sCACxB,YAAU,QAAQ,WAAW,4DAE5BA,MAAA,IAAA,EAAK,QAAQ,WAAW,CAAA;;;;AACP,YAAA,QAAQ,YAAU;AAAE,gBAAAE,mBAAA,0BAAA,EAAA,OAAA,MAAK,MAAA,OAAA,CAAA;AAAA,QAC7B,WAAA,QAAQ,UAAQ;2DAAwB,QAAQ,SAAS,MAAM,CAAA,SAAA;AAAA;;;6DAChDF,MAAA,UAAA,EAAW,QAAQ,WAAW,CAAA,CAAA,eAAA;;UAGrD,IAAE,SAAW,QAAQ,IAAI;AAAA,UAAI,OAAM;AAAA,QAAA;2BAA9C,CAWW,GAAAG,QAAAC,UAAA,aAAA;;wIATJC,eAAA,QAAQ,OAAO;AAGZ,kBAAA,QAAQ,UAAQ;4CACrB,OAAK,QAAQ,QAAQ,IAAGC,cAAA,OAAK,QAAQ,YAAY,QAAQ,OAAO;;;;;;gBALnEC,YAEK,QAFD,OAAM,2FAAA,GAA0FC,gBAC/F,QAAQ,OAAO,GAAA,CAAA;AAAA,gBAGZ,QAAQ,yBADhBC,YAMC,OAAA;AAAA;kBAJE,KAAK,QAAQ;AAAA,kBAAW,KAAK,QAAQ,YAAY,QAAQ;AAAA,kBAC1D,OAAM;AAAA,kBAAK,QAAO;AAAA,kBAClB,OAAM;AAAA,kBACN,SAAQ;AAAA,kBAAO,UAAS;AAAA,gBAAA;;;;;;;;;;QAQxB,UAAS;AAAA,QAAe,uBAAA;AAAA,MAAA;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList","_ssrRenderComponent","_push","_parent","_ssrInterpolate","_ssrRenderAttr","_createVNode","_toDisplayString","_createBlock"],"sources":["../../../../pages/live.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { ArticleCard } from '~/types'\n\n/** 🔴 LIVE NOW timeline (§8). */\n\nconst { t } = useLocale()\nconst { data: initial } = await useAsyncApi<ArticleCard[]>('live-feed', '/api/live', { limit: 30 })\n\nconst store = useBreakingStore()\nconst { connected } = useBreakingSocket()\nconst { time, relativeKh } = useFormat()\n\n// The pushed breaking items lead the timeline, with the wider live feed behind\n// them, deduplicated.\nconst items = computed(() => {\n  const seen = new Set<number>()\n  const out: ArticleCard[] = []\n  for (const article of [...store.items, ...(initial.value ?? [])]) {\n    if (seen.has(article.id)) continue\n    seen.add(article.id)\n    out.push(article)\n  }\n  return out\n})\n\nuseSiteSeo({\n  title: `${t('live')} — LIVE`,\n  description: t('liveDesc'),\n  path: '/live',\n})\n</script>\n\n<template>\n  <div class=\"container-content\">\n    <header class=\"flex flex-wrap items-center gap-3 border-b-2 border-breaking pb-4\">\n      <h1 class=\"flex items-center gap-2 text-kh-2xl font-bold sm:text-kh-3xl\">\n        <span class=\"inline-block h-3 w-3 rounded-full bg-breaking animate-pulse-dot\" aria-hidden=\"true\" />\n        {{ t('live') }}\n      </h1>\n      <span class=\"text-sm text-ink-muted\">LIVE NOW</span>\n\n      <span\n        :class=\"[\n          'ml-auto rounded-full px-2.5 py-1 text-xs font-semibold',\n          connected ? 'bg-success/10 text-success' : 'bg-ink/10 text-ink-muted',\n        ]\"\n      >\n        {{ connected ? t('liveUpdating') : t('refreshingEachMinute') }}\n      </span>\n    </header>\n\n    <div class=\"mt-6 grid gap-8 lg:grid-cols-3\">\n      <!-- aria-live so a reader using a screen reader hears new items arrive\n           without having to re-read the page. -->\n      <ol class=\"lg:col-span-2\" aria-live=\"polite\">\n        <li\n          v-for=\"article in items\"\n          :key=\"article.id\"\n          class=\"relative flex gap-4 border-l-2 border-line pb-6 pl-5 last:pb-0\"\n        >\n          <span\n            :class=\"[\n              'absolute -left-[7px] top-1.5 h-3 w-3 rounded-full ring-4 ring-surface',\n              article.isBreaking ? 'bg-breaking' : 'bg-brand',\n            ]\"\n            aria-hidden=\"true\"\n          />\n\n          <div class=\"min-w-0 flex-1\">\n            <div class=\"mb-1 flex flex-wrap items-center gap-2 text-xs\">\n              <time\n                v-if=\"article.publishedAt\"\n                :datetime=\"article.publishedAt\"\n                class=\"font-bold tabular-nums text-ink\"\n              >{{ time(article.publishedAt) }}</time>\n              <BreakingBadge v-if=\"article.isBreaking\" small />\n              <span v-else-if=\"article.category\" class=\"text-brand\">{{ article.category.nameKh }}</span>\n              <span class=\"text-ink-muted\">{{ relativeKh(article.publishedAt) }}</span>\n            </div>\n\n            <NuxtLink :to=\"`/news/${article.slug}`\" class=\"group flex gap-3\">\n              <h2 class=\"min-w-0 flex-1 text-kh-base font-semibold leading-snug khmer-wrap group-hover:text-brand\">\n                {{ article.titleKh }}\n              </h2>\n              <img\n                v-if=\"article.imageUrl\"\n                :src=\"article.imageUrl\" :alt=\"article.imageAlt || article.titleKh\"\n                width=\"96\" height=\"54\"\n                class=\"h-auto w-20 shrink-0 rounded object-cover sm:w-24\"\n                loading=\"lazy\" decoding=\"async\"\n              >\n            </NuxtLink>\n          </div>\n        </li>\n      </ol>\n\n      <aside class=\"space-y-8\">\n        <AdSlot position=\"HOME_SIDEBAR\" collapse-when-empty />\n        <FiveMinuteNews />\n        <NewsPulse />\n      </aside>\n    </div>\n  </div>\n</template>\n"],"version":3}