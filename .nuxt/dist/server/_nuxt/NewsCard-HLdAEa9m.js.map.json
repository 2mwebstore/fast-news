;YAAG,SAAS,QAAA,QAAQ;AAAA,UAAA;;;;;;UAKlD,IAAIA,MAAA,IAAA;AAAA,UACL,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAC,QAAAC,UAAA,aAAA;;AADND,qBAAA,GAAAE,eAAAH,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,CAAA,EAAA;AAAA;;gBAAbI,gBAAAC,gBAAAL,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;AAIX,YAAAA,MAAA,OAAA,EAAQ,QAAA,OAAO,GAAA;AACnB,gBAAA,kEAAAG,eAAAH,MAAA,OAAA,EAAQ,QAAA,OAAO,CAAA,CAAA,MAAA;AAAA;;;;UAKL,SAAS,QAAA;AAAA,UAAS,OAAM;AAAA,QAAA;;iBAMxB,QAAA,YAAO,WAAA;;AAElB,YAAA,QAAA,SAAS,QAAS;sHAEtB,OAAO,QAAA,IAAI,EAAE,SAAQ,GAAA,GAAA,CAAA,CAAA,SAAA;AAAA;;;;UAEd,IAAIA,MAAA,IAAA;AAAA,UAAM,OAAM;AAAA,QAAA;2BAA3B,CAqBW,GAAAC,QAAAC,UAAA,aAAA;;;kBAlBO,QAAA,YAAY,QAAA,QAAQ,aAAW;4GACtCF,MAAA,IAAA,EAAK,QAAA,QAAQ,WAAW,CAAA;;;;AAER,kBAAA,QAAA,QAAQ,YAAU;AAAEC,uBAAAO,mBAAA,0BAAA,EAAA,OAAA,MAAK,MAAAN,UAAA,QAAA,CAAA;AAAA,cAC7B,WAAA,QAAA,QAAQ,UAAQ;6EAAwBF,MAAA,YAAA,EAAa,QAAA,QAAQ,QAAQ,CAAA;;;;kBAChEA,MAAA,WAAA,GAAW;;kBAAG,SAAS,QAAA,QAAQ;AAAA,kBAAa,OAAA;AAAA,gBAAA;;;;0IAG/DG,eAAAH,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA;AAKZ,kBAAA,QAAA,QAAQ,UAAQ;;kBACrB,KAAK,QAAA,QAAQ;AAAA,kBAAW,KAAKA,MAAA,QAAA;AAAA,kBAC7B,OAAO;AAAA,kBAAK,QAAQ;AAAA,kBAAK,OAAO;AAAA,kBACjC,OAAM;AAAA,gBAAA;;;;;;gBAlBRS,YAYM,OAAA,EAZD,OAAM,oBAAgB;AAAA,kBACzBA,YAOM,OAAA,EAPD,OAAM,oDAAgD;AAAA,oBAC7C,QAAA,YAAY,QAAA,QAAQ,4BAAhCF,YAEO,QAAA;AAAA;sBAFsC,OAAM;AAAA,oBAAA,mBAC9CP,MAAA,IAAA,EAAK,QAAA,QAAQ,WAAW,CAAA,GAAA,CAAA;oBAER,QAAA,QAAQ,2BAA7BO,YAAiD,0BAAA;AAAA;sBAAR,OAAA;AAAA,oBAAA,MACxB,QAAA,QAAQ,yBAAzBA,YAAiG,QAAA;AAAA;sBAA9D,OAAM;AAAA,oBAAA,mBAAgBP,MAAA,YAAA,EAAa,QAAA,QAAQ,QAAQ,CAAA,GAAA,CAAA;oBAChEA,MAAA,WAAA,kBAAtBO,YAA0E,2BAAA;AAAA;sBAAtC,SAAS,QAAA,QAAQ;AAAA,sBAAa,OAAA;AAAA,oBAAA;;kBAEpEE,YAEK,QAFD,OAAM,0FAAsFJ,gBAC3FL,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,GAAA,CAAA;AAAA,gBAAA;gBAKZ,QAAA,QAAQ,yBADhBO,YAKE,uBAAA;AAAA;kBAHC,KAAK,QAAA,QAAQ;AAAA,kBAAW,KAAKP,MAAA,QAAA;AAAA,kBAC7B,OAAO;AAAA,kBAAK,QAAQ;AAAA,kBAAK,OAAO;AAAA,kBACjC,OAAM;AAAA,gBAAA;;;;;;;iBAMS,QAAA,YAAO,QAAA;;;UAGrB,KAAK,QAAA,QAAQ;AAAA,UAAW,KAAKA,MAAA,QAAA;AAAA,UAC7B,OAAO,QAAA,QAAQ,cAAU;AAAA,UAAU,QAAQ,QAAA,QAAQ,eAAW;AAAA,UAC9D,OAAO;AAAA,UACR,aAAU;AAAA,UACV,OAAM;AAAA,QAAA;;YAKQ,QAAA,YAAY,QAAA,QAAQ,aAAW;0FACtCA,MAAA,IAAA,EAAK,QAAA,QAAQ,WAAW,CAAA,CAAA,SAAA;AAAA;;;AAER,YAAA,QAAA,QAAQ,YAAU;AAAE,gBAAAQ,mBAAA,0BAAA,EAAA,OAAA,MAAK,MAAA,OAAA,CAAA;AAAA,QAC7B,WAAA,QAAA,QAAQ,UAAQ;+DAA4BR,MAAA,YAAA,EAAa,QAAA,QAAQ,QAAQ,CAAA,CAAA,SAAA;AAAA;;;YACpEA,MAAA,WAAA,GAAW;;YAAG,SAAS,QAAA,QAAQ;AAAA,YAAa,OAAA;AAAA,UAAA;;;;;;UAK/D,IAAIA,MAAA,IAAA;AAAA,UACL,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAC,QAAAC,UAAA,aAAA;;AADND,qBAAA,GAAAE,eAAAH,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,CAAA,EAAA;AAAA;;gBAAbI,gBAAAC,gBAAAL,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;AAIX,YAAAA,MAAA,OAAA,EAAQ,QAAA,OAAO,GAAA;AACnB,gBAAA,qFAAAG,eAAAH,MAAA,OAAA,EAAQ,QAAA,OAAO,CAAA,CAAA,MAAA;AAAA;;;;UAGL,SAAS,QAAA;AAAA,UAAS,OAAM;AAAA,QAAA;;;;UAOhC,IAAIA,MAAA,IAAA;AAAA,UAAM,OAAM;AAAA,QAAA;2BAA3B,CAgCW,GAAAC,QAAAC,UAAA,aAAA;;;gBA9BN,KAAK,QAAA,QAAQ;AAAA,gBAAW,KAAKF,MAAA,QAAA;AAAA,gBAC7B,OAAO,QAAA,QAAQ,cAAU;AAAA,gBAAU,QAAQ,QAAA,QAAQ,eAAW;AAAA,gBAC9D,OAAO;AAAA,gBAAS,UAAU,QAAA;AAAA,gBAC3B,aAAU;AAAA,gBACV,OAAM;AAAA,cAAA;iCALR,CAQaU,IAAAT,QAAAC,UAAAS,cAAA;;AADe,wBAAA,QAAA,QAAQ,oBAAkB;;;;;;;sBAA1B,QAAA,QAAQ,mCAAlCJ,YAAwD,+BAAA,EAAA,KAAA,EAAA,CAAA;;;;;;;AAKjC,kBAAA,QAAA,QAAQ,YAAU;AAAEN,uBAAAO,mBAAA,0BAAA,EAAA,OAAA,MAAK,MAAAN,UAAA,QAAA,CAAA;AAAA,cAC7B,WAAA,QAAA,QAAQ,UAAQ;iFAA4BF,MAAA,YAAA,EAAa,QAAA,QAAQ,QAAQ,CAAA;;;;kBACpEA,MAAA,WAAA,GAAW;;kBAAG,SAAS,QAAA,QAAQ;AAAA,kBAAa,OAAA;AAAA,gBAAA;;;;4IAI/DG,eAAAH,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA;AAIJ,kBAAA,QAAA,QAAQ,aAAW;6CAAG,YAAU,QAAA,QAAQ,WAAW,+BAC1DA,MAAA,UAAA,EAAW,QAAA,QAAQ,WAAW,CAAA;;;;AAEnB,kBAAA,QAAA,QAAQ,YAAS,GAAA;8GAEtBA,MAAA,OAAA,EAAQ,QAAA,QAAQ,SAAS,CAAA;;;;;;;gBA3BxCS,YAQa,uBAAA;AAAA,kBAPV,KAAK,QAAA,QAAQ;AAAA,kBAAW,KAAKT,MAAA,QAAA;AAAA,kBAC7B,OAAO,QAAA,QAAQ,cAAU;AAAA,kBAAU,QAAQ,QAAA,QAAQ,eAAW;AAAA,kBAC9D,OAAO;AAAA,kBAAS,UAAU,QAAA;AAAA,kBAC3B,aAAU;AAAA,kBACV,OAAM;AAAA,gBAAA;mCAEN,MAAwD;AAAA,oBAA9B,QAAA,QAAQ,mCAAlCO,YAAwD,+BAAA,EAAA,KAAA,EAAA,CAAA;;;;gBAG1DE,YAoBM,OAAA,EApBD,OAAM,sBAAkB;AAAA,kBAC3BA,YAIM,OAAA,EAJD,OAAM,+CAA2C;AAAA,oBAC/B,QAAA,QAAQ,2BAA7BF,YAAiD,0BAAA;AAAA;sBAAR,OAAA;AAAA,oBAAA,MACxB,QAAA,QAAQ,yBAAzBA,YAAqG,QAAA;AAAA;sBAAlE,OAAM;AAAA,oBAAA,mBAAoBP,MAAA,YAAA,EAAa,QAAA,QAAQ,QAAQ,CAAA,GAAA,CAAA;oBACpEA,MAAA,WAAA,kBAAtBO,YAA0E,2BAAA;AAAA;sBAAtC,SAAS,QAAA,QAAQ;AAAA,sBAAa,OAAA;AAAA,oBAAA;;kBAGpEE,YAEK,QAFD,OAAM,4FAAwFJ,gBAC7FL,MAAA,KAAA,EAAM,QAAA,OAAO,CAAA,GAAA,CAAA;AAAA,kBAGlBS,YAQM,OAAA,EARD,OAAM,oDAAgD;AAAA,oBAC7C,QAAA,QAAQ,4BAApBF,YAEO,QAAA;AAAA;sBAF2B,UAAU,QAAA,QAAQ;AAAA,oBAAA,mBAC/CP,MAAA,UAAA,EAAW,QAAA,QAAQ,WAAW,CAAA,GAAA,GAAA,CAAA,UAAA,CAAA;oBAEnB,QAAA,QAAQ,YAAS,kBAAjCO,YAGWK,UAAA,EAAA,KAAA,KAAA;AAAA,sBAFTH,YAAiC,QAAA,EAA3B,eAAY,OAAA,GAAO,GAAC;AAAA,sBAC1BA,YAA6C,QAAA,MAAAJ,gBAApCL,MAAA,OAAA,EAAQ,QAAA,QAAQ,SAAS,CAAA,GAAA,CAAA;AAAA,oBAAA;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent","_ssrInterpolate","_createTextVNode","_toDisplayString","_ssrRenderAttr","_createBlock","_ssrRenderComponent","_createVNode","_","_scopeId","_Fragment"],"sources":["../../../../components/ArticleImageNotice.vue","../../../../components/SponsoredBadge.vue","../../../../components/NewsCardMeta.vue","../../../../components/NewsCard.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst { t } = useLocale()\n\n/**\n * Overlay marking an AI-generated illustration (§25). An AI image must never\n * read as a photograph of a real event, so the notice sits on the image itself\n * rather than in a caption that can be scrolled past.\n */\n</script>\n\n<template>\n  <span\n    class=\"absolute bottom-2 left-2 rounded bg-ink/75 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm\"\n  >\n    {{ t('aiImageNotice') }}\n  </span>\n</template>\n","<script setup lang=\"ts\">\n/**\n * The paid-content label (§42). It renders wherever sponsored content appears,\n * including inside feeds, so a reader is never shown paid material presented\n * as independent reporting.\n */\nwithDefaults(defineProps<{ sponsor?: string; small?: boolean }>(), { small: false })\nconst { t } = useLocale()\n</script>\n\n<template>\n  <span :class=\"['badge-sponsored', small ? 'text-[10px]' : 'text-xs']\">\n    {{ t('sponsored') }}<template v-if=\"sponsor\"> · {{ sponsor }}</template>\n  </span>\n</template>\n","<script setup lang=\"ts\">\nimport type { ArticleCard } from '~/types'\n\n/** The byline/time/reading-time line shared by the larger card variants. */\ndefineProps<{ article: ArticleCard }>()\nconst { dateTime, iso, khNumber } = useFormat()\nconst { t, isEnglish } = useLocale()\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted\">\n    <NuxtLink\n      v-if=\"article.author\"\n      :to=\"`/author/${article.author.slug}`\"\n      class=\"font-medium text-ink hover:text-brand\"\n    >\n      {{ isEnglish && article.author.nameEn ? article.author.nameEn : article.author.nameKh }}\n    </NuxtLink>\n    <span v-if=\"article.author\" aria-hidden=\"true\">•</span>\n\n    <time v-if=\"article.publishedAt\" :datetime=\"iso(article.publishedAt)\">\n      {{ dateTime(article.publishedAt) }}\n    </time>\n\n    <template v-if=\"article.readingMinutes\">\n      <span aria-hidden=\"true\">•</span>\n      <span>{{ t('readMinutes', { n: isEnglish ? article.readingMinutes : khNumber(article.readingMinutes) }) }}</span>\n    </template>\n  </div>\n</template>\n","<script setup lang=\"ts\">\nimport type { ArticleCard } from '~/types'\n\n/**\n * NewsCard is the single article presentation used across every feed.\n * `variant` changes the layout; the metadata shown stays consistent so a\n * sponsored item is labelled identically wherever it appears (§42).\n */\nconst props = withDefaults(defineProps<{\n  article: ArticleCard\n  variant?: 'grid' | 'list' | 'compact' | 'hero'\n  /** Shows the leading timestamp used by the latest-news feed (§10). */\n  showTime?: boolean\n  /** Index for the numbered five-minute list (§11). */\n  rank?: number\n  /** Only the first card above the fold should load eagerly. */\n  priority?: boolean\n}>(), { variant: 'grid', showTime: false, priority: false })\n\nconst { time, relativeKh, compact } = useFormat()\nconst { title, summary, categoryName } = useLocale()\n\nconst href = computed(() => `/news/${props.article.slug}`)\nconst isSponsored = computed(() => props.article.contentType !== 'editorial')\n\n// Alt text falls back to the headline rather than being left empty: a\n// decorative-empty alt on a news photo is wrong for screen readers (§55).\nconst imageAlt = computed(() => props.article.imageAlt || title(props.article))\n\n// Cards are fixed 16:9 so a grid never reflows as images arrive.\nconst aspect = '16 / 9'\n</script>\n\n<template>\n  <article :class=\"['group', variant === 'compact' ? 'flex gap-3' : '']\">\n    <!-- ── Hero ──────────────────────────────────────────────────────── -->\n    <!--\n      The card is made clickable by stretching the headline link's\n      pseudo-element over it, rather than wrapping everything in one anchor.\n      Wrapping would nest the byline link inside the card link, which is\n      invalid HTML and breaks hydration.\n    -->\n    <template v-if=\"variant === 'hero'\">\n      <div class=\"relative\">\n        <SmartImage\n          :src=\"article.imageUrl\"\n          :alt=\"imageAlt\"\n          :width=\"article.imageWidth || 1200\"\n          :height=\"article.imageHeight || 675\"\n          :ratio=\"aspect\"\n          :priority=\"priority\"\n          img-class=\"transition-transform duration-300 group-hover:scale-[1.02]\"\n          class=\"rounded-lg\"\n        >\n          <ArticleImageNotice v-if=\"article.imageIsAiGenerated\" />\n        </SmartImage>\n\n        <div class=\"mt-4 space-y-2\">\n          <div class=\"flex flex-wrap items-center gap-2\">\n            <BreakingBadge v-if=\"article.isBreaking\" />\n            <span v-else-if=\"article.category\" class=\"badge-category\">\n              {{ categoryName(article.category) }}\n            </span>\n            <SponsoredBadge v-if=\"isSponsored\" :sponsor=\"article.sponsorName\" />\n          </div>\n\n          <h2 class=\"text-kh-2xl font-bold leading-snug khmer-wrap sm:text-kh-3xl\">\n            <NuxtLink\n              :to=\"href\"\n              class=\"after:absolute after:inset-0 after:content-[''] group-hover:text-brand\"\n            >\n              {{ title(article) }}\n            </NuxtLink>\n          </h2>\n\n          <p v-if=\"summary(article)\" class=\"line-clamp-2 text-kh-base text-ink-muted khmer-wrap\">\n            {{ summary(article) }}\n          </p>\n\n          <!-- z-10 lifts the byline above the stretched overlay so it stays\n               independently clickable. -->\n          <NewsCardMeta :article=\"article\" class=\"relative z-10\" />\n        </div>\n      </div>\n    </template>\n\n    <!-- ── Compact: a text row with a small thumbnail ─────────────────── -->\n    <template v-else-if=\"variant === 'compact'\">\n      <span\n        v-if=\"rank !== undefined\"\n        class=\"mt-0.5 w-7 shrink-0 text-lg font-extrabold tabular-nums text-brand/40\"\n      >{{ String(rank).padStart(2, '0') }}</span>\n\n      <NuxtLink :to=\"href\" class=\"flex min-w-0 flex-1 gap-3\">\n        <div class=\"min-w-0 flex-1\">\n          <div class=\"mb-1 flex flex-wrap items-center gap-2 text-xs\">\n            <time v-if=\"showTime && article.publishedAt\" class=\"font-semibold tabular-nums text-ink-muted\">\n              {{ time(article.publishedAt) }}\n            </time>\n            <BreakingBadge v-if=\"article.isBreaking\" small />\n            <span v-else-if=\"article.category\" class=\"text-brand\">{{ categoryName(article.category) }}</span>\n            <SponsoredBadge v-if=\"isSponsored\" :sponsor=\"article.sponsorName\" small />\n          </div>\n          <h3 class=\"line-clamp-2 text-kh-sm font-semibold leading-snug khmer-wrap group-hover:text-brand\">\n            {{ title(article) }}\n          </h3>\n        </div>\n\n        <SmartImage\n          v-if=\"article.imageUrl\"\n          :src=\"article.imageUrl\" :alt=\"imageAlt\"\n          :width=\"96\" :height=\"54\" :ratio=\"aspect\"\n          class=\"w-20 shrink-0 rounded sm:w-24\"\n        />\n      </NuxtLink>\n    </template>\n\n    <!-- ── List: image beside a headline and summary ──────────────────── -->\n    <template v-else-if=\"variant === 'list'\">\n      <div class=\"relative flex w-full gap-3 sm:gap-4\">\n        <SmartImage\n          :src=\"article.imageUrl\" :alt=\"imageAlt\"\n          :width=\"article.imageWidth || 352\" :height=\"article.imageHeight || 198\"\n          :ratio=\"aspect\"\n          img-class=\"transition-transform duration-300 group-hover:scale-[1.03]\"\n          class=\"w-28 shrink-0 rounded-lg sm:w-44\"\n        />\n\n        <div class=\"min-w-0 flex-1\">\n          <div class=\"mb-1.5 flex flex-wrap items-center gap-2 text-xs\">\n            <time v-if=\"showTime && article.publishedAt\" class=\"font-semibold tabular-nums text-ink-muted\">\n              {{ time(article.publishedAt) }}\n            </time>\n            <BreakingBadge v-if=\"article.isBreaking\" small />\n            <span v-else-if=\"article.category\" class=\"badge-category\">{{ categoryName(article.category) }}</span>\n            <SponsoredBadge v-if=\"isSponsored\" :sponsor=\"article.sponsorName\" small />\n          </div>\n\n          <h3 class=\"line-clamp-3 text-kh-base font-semibold leading-snug khmer-wrap sm:text-kh-lg\">\n            <NuxtLink\n              :to=\"href\"\n              class=\"after:absolute after:inset-0 after:content-[''] group-hover:text-brand\"\n            >\n              {{ title(article) }}\n            </NuxtLink>\n          </h3>\n\n          <p v-if=\"summary(article)\" class=\"mt-1 hidden line-clamp-2 text-kh-sm text-ink-muted khmer-wrap sm:block\">\n            {{ summary(article) }}\n          </p>\n\n          <NewsCardMeta :article=\"article\" class=\"relative z-10 mt-2 hidden sm:flex\" />\n        </div>\n      </div>\n    </template>\n\n    <!-- ── Grid (default) ────────────────────────────────────────────── -->\n    <template v-else>\n      <NuxtLink :to=\"href\" class=\"block\">\n        <SmartImage\n          :src=\"article.imageUrl\" :alt=\"imageAlt\"\n          :width=\"article.imageWidth || 640\" :height=\"article.imageHeight || 360\"\n          :ratio=\"aspect\" :priority=\"priority\"\n          img-class=\"transition-transform duration-300 group-hover:scale-[1.03]\"\n          class=\"rounded-lg\"\n        >\n          <ArticleImageNotice v-if=\"article.imageIsAiGenerated\" />\n        </SmartImage>\n\n        <div class=\"mt-3 space-y-1.5\">\n          <div class=\"flex flex-wrap items-center gap-2 text-xs\">\n            <BreakingBadge v-if=\"article.isBreaking\" small />\n            <span v-else-if=\"article.category\" class=\"badge-category\">{{ categoryName(article.category) }}</span>\n            <SponsoredBadge v-if=\"isSponsored\" :sponsor=\"article.sponsorName\" small />\n          </div>\n\n          <h3 class=\"line-clamp-3 text-kh-base font-semibold leading-snug khmer-wrap group-hover:text-brand\">\n            {{ title(article) }}\n          </h3>\n\n          <div class=\"flex items-center gap-2 text-xs text-ink-muted\">\n            <time v-if=\"article.publishedAt\" :datetime=\"article.publishedAt\">\n              {{ relativeKh(article.publishedAt) }}\n            </time>\n            <template v-if=\"article.viewCount > 0\">\n              <span aria-hidden=\"true\">•</span>\n              <span>{{ compact(article.viewCount) }}</span>\n            </template>\n          </div>\n        </div>\n      </NuxtLink>\n    </template>\n  </article>\n</template>\n"],"version":3}