{"file":"_slug_-1hEkuyWE.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAIA,UAAM,QAAQ,SAAA;AACd,UAAM,SAAS,iBAAA;AACf,UAAM,MAAM,OAAA;AACZ,UAAM,EAAE,UAAU,UAAU,QAAA,IAAY,UAAA;AACxC,UAAM,EAAE,GAAG,OAAO,YAAY,OAAA,IAAW,UAAA;AAEzC,UAAM,OAAO,SAAS,MAAM,OAAO,MAAM,OAAO,IAAI,CAAC;AAErD,UAAM,EAAE,MAAM,OAAO,MAAA,KAAU,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MACnC,MAAM,SAAS,KAAK,KAAK;AAAA,MACzB,MAAM,IAAI,IAAmB,cAAc,KAAK,KAAK,EAAE;AAAA,MACvD,EAAE,OAAO,CAAC,IAAI,EAAA;AAAA,IAAE,CAClB;AAEA,QAAI,MAAM,MAAO,OAAM,UAAU,MAAM,OAAO,iBAAiB;AAC/D,QAAI,CAAC,MAAM,OAAO;AAChB,YAAM,YAAY,EAAE,YAAY,KAAK,eAAe,mBAAmB,OAAO,MAAM;AAAA,IACtF;AAEA,UAAM,EAAE,MAAM,UAAS,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,YAA6B,cAAc,cAAc,EAAE,OAAO,EAAA,CAAG,CAAA;AAIlG,UAAM,MAAM,MAAM,MAAM;AACxB,eAAW;AAAA,MACT,OAAO,KAAK,YAAY,MAAM,MAAM;AAAA,MACpC,aAAa,KAAK,kBAAkB,MAAM,MAAM,UAAU,MAAM,MAAM;AAAA,MACtE,MAAM,UAAU,MAAM,MAAM,IAAI;AAAA,MAChC,OAAO,KAAK,WAAW,MAAM,MAAM;AAAA,MACnC,MAAM;AAAA,MACN,WAAW,KAAK,gBAAgB;AAAA,MAChC,UAAU,KAAK,aAAa,SAAS,IAAI,cAAc;AAAA,MACvD,QAAQ,KAAK,UAAU;AAAA,MACvB,SAAS,KAAK,WAAW;AAAA,MACzB,eAAe,KAAK,iBAAiB;AAAA,MACrC,cAAc,KAAK,gBAAgB;AAAA,MACnC,oBAAoB,KAAK,sBAAsB;AAAA,MAC/C,cAAc,KAAK,gBAAgB;AAAA,IAAA,CACpC;AAED,cAAU;AAAA,MACR,YAAY;AAAA,MACZ,SAAS;AAAA,MACT,MAAM,KAAK,YAAY,MAAM,MAAM;AAAA,MACnC,aAAa,KAAK,kBAAkB,MAAM,MAAM,UAAU,MAAM,MAAM;AAAA,MACtE,cAAc,MAAM,MAAM,gBAAgB;AAAA,MAC1C,YAAY,MAAM,MAAM,eAAe;AAAA;AAAA,MAEvC,UAAU,MAAM,MAAM,cAAc,KAAK,MAAM,MAAM,WAAW,MAAM;AAAA,MACtE,YAAY,MAAM,MAAM,YAAY,MAAM,MAAM,aAAa;AAAA,MAC7D,UAAU,MAAM,MAAM,YAAY,GAAG,OAAO,OAAO,OAAO,UAAU,MAAM,MAAM,IAAI;AAAA,MACpF,WAAW,EAAE,SAAS,yBAAyB,MAAM,OAAO,OAAO,SAAA;AAAA,IAAS,CAC7E;;;;;;;UAIYC,MAAA,KAAA,GAAK;AAAE,cAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,uBAAoB,MAAA,CAAA,CAAA,0EAAA;;UAMnC,cAAYF,MAAA,KAAA,EAAM;AAAA,UAClB,aAAWA,MAAA,KAAA,EAAM;AAAA,UACjB,OAAOA,MAAA,UAAA,EAAWA,MAAA,KAAA,CAAK;AAAA,UACvB,QAAQA,MAAA,KAAA,EAAM;AAAA,UACd,cAAYA,MAAA,KAAA,EAAM;AAAA,UACnB,UAAA;AAAA,QAAA;AAGiE,cAAA,mEAAAG,eAAAH,MAAA,UAAA,EAAWA,MAAA,KAAA,CAAK,CAAA,CAAA,kFAAA;AAGrE,YAAAA,MAAA,KAAA,EAAM,UAAQ;AACrB,gBAAA,gCAAAG,eAAAH,MAAA,MAAA,cAAmBA,MAAA,KAAA,EAAM,SAAS,SAASA,MAAA,KAAA,EAAM,SAAS,SAASA,aAAM,SAAS,MAAM,CAAA,SAAA;AAAA;;;AAEjF,YAAAA,MAAA,KAAA,EAAM,aAAW;sCAAG,YAAUA,MAAA,KAAA,EAAM,WAAW,oBAAKA,MAAA,QAAA,EAASA,MAAA,KAAA,EAAM,WAAW,CAAA;;;;AAC9E,YAAAA,MAAA,KAAA,EAAM,WAAS;0CAAOA,MAAA,OAAA,EAAQA,MAAA,KAAA,EAAM,SAAS,CAAA,oBAAQA,MAAA,CAAA,EAAC,OAAA,CAAA;;;;AACtD,YAAAA,MAAA,KAAA,EAAM,aAAW;0CAAOA,MAAA,QAAA,EAASA,MAAA,KAAA,EAAM,WAAW,CAAA,CAAA,SAAA;AAAA;;;;AAGvD,YAAAA,MAAA,KAAA,EAAM,QAAM;AAA0C,gBAAA,2CAAAG,eAAAH,MAAA,KAAA,EAAM,MAAM,CAAA,MAAA;AAAA;;;;;UAMtE,MAAI,UAAYA,MAAA,KAAA,EAAM,IAAI;AAAA,UAC1B,OAAOA,MAAA,UAAA,EAAWA,MAAA,KAAA,CAAK;AAAA,UACvB,cAAU,cAAgBA,MAAA,KAAA,EAAM,IAAI;AAAA,UACrC,UAAA;AAAA,QAAA;;;UAII,UAAS;AAAA,UAAiB,uBAAA;AAAA,QAAA;;;UAIjB,OAAOA,MAAA,CAAA,EAAC,YAAA;AAAA,UAAgB,MAAK;AAAA,QAAA;;AAEjBI,uBAAAJ,MAAA,IAAA,KAAI,CAAA,GAAQ,OAAO,CAAA,MAAK,EAAE,OAAOA,MAAA,KAAA,EAAO,EAAE,IAAnD,SAAI;;YAAmD,KAAK,KAAK;AAAA,YAAK,OAAO;AAAA,UAAA;;;;;;;;;;;;;;;","names":["_withAsyncContext","_unref","_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_ssrRenderList"],"sources":["../../../../pages/video/[slug].vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { VideoCard as VideoCardType } from '~/types'\n\n/** Video detail (§26) with VideoObject structured data. */\nconst route = useRoute()\nconst config = useRuntimeConfig()\nconst api = useApi()\nconst { duration, dateTime, compact } = useFormat()\nconst { t, title: localTitle, locale } = useLocale()\n\nconst slug = computed(() => String(route.params.slug))\n\nconst { data: video, error } = await useAsyncData(\n  () => `video-${slug.value}`,\n  () => api.get<VideoCardType>(`/api/video/${slug.value}`),\n  { watch: [slug] },\n)\n\nif (error.value) throw pageError(error.value, 'Video not found')\nif (!video.value) {\n  throw createError({ statusCode: 404, statusMessage: 'Video not found', fatal: true })\n}\n\nconst { data: more } = await useAsyncApi<VideoCardType[]>('video-more', '/api/video', { limit: 6 })\n\n// Editor overrides win; the video's own title and description are the fallback,\n// which is what most videos will use.\nconst seo = video.value.seo\nuseSiteSeo({\n  title: seo?.seoTitle || video.value.titleKh,\n  description: seo?.seoDescription || video.value.descKh || video.value.titleKh,\n  path: `/video/${video.value.slug}`,\n  image: seo?.ogImage || video.value.thumbnailUrl,\n  type: 'article',\n  canonical: seo?.canonicalUrl || undefined,\n  keywords: seo?.seoKeywords?.length ? seo.seoKeywords : undefined,\n  robots: seo?.robots || undefined,\n  ogTitle: seo?.ogTitle || undefined,\n  ogDescription: seo?.ogDescription || undefined,\n  twitterTitle: seo?.twitterTitle || undefined,\n  twitterDescription: seo?.twitterDescription || undefined,\n  twitterImage: seo?.twitterImage || undefined,\n})\n\nuseJsonLd({\n  '@context': 'https://schema.org',\n  '@type': 'VideoObject',\n  name: seo?.seoTitle || video.value.titleKh,\n  description: seo?.seoDescription || video.value.descKh || video.value.titleKh,\n  thumbnailUrl: video.value.thumbnailUrl || undefined,\n  uploadDate: video.value.publishedAt || undefined,\n  // ISO 8601 duration, which is what Google expects here.\n  duration: video.value.durationSec ? `PT${video.value.durationSec}S` : undefined,\n  contentUrl: video.value.watchUrl || video.value.sourceUrl || undefined,\n  embedUrl: video.value.embedUrl || `${config.public.siteUrl}/video/${video.value.slug}`,\n  publisher: { '@type': 'NewsMediaOrganization', name: config.public.siteName },\n})\n</script>\n\n<template>\n  <div v-if=\"video\" class=\"container-content \">\n    <div class=\"grid gap-8 lg:grid-cols-3 mt-2\">\n      <div class=\"lg:col-span-2\">\n        <!-- This page exists to play the video, so the player loads directly\n             rather than behind a facade. -->\n        <YouTubeEmbed\n          :youtube-id=\"video.youtubeId\"\n          :embed-url=\"video.embedUrl\"\n          :title=\"localTitle(video)\"\n          :poster=\"video.thumbnailUrl\"\n          :poster-alt=\"video.thumbnailAlt\"\n          autoload\n        />\n\n        <h1 class=\"mt-4 text-kh-xl font-bold khmer-wrap sm:text-kh-2xl\">{{ localTitle(video) }}</h1>\n\n        <div class=\"mt-2 flex flex-wrap items-center gap-2 text-sm text-ink-muted\">\n          <span v-if=\"video.category\" class=\"badge-category\">\n            {{ locale === 'en' && video.category.nameEn ? video.category.nameEn : video.category.nameKh }}\n          </span>\n          <time v-if=\"video.publishedAt\" :datetime=\"video.publishedAt\">{{ dateTime(video.publishedAt) }}</time>\n          <span v-if=\"video.viewCount\">• {{ compact(video.viewCount) }} {{ t('views') }}</span>\n          <span v-if=\"video.durationSec\">• {{ duration(video.durationSec) }}</span>\n        </div>\n\n        <p v-if=\"video.descKh\" class=\"mt-4 text-kh-base khmer-wrap\">{{ video.descKh }}</p>\n\n        <!-- Shares are counted against the video, not the article endpoint, so\n             the analytics breakdown attributes them correctly (§43). -->\n        <div class=\"mt-6 border-t border-line pt-4\">\n          <ShareLinks\n            :path=\"`/video/${video.slug}`\"\n            :title=\"localTitle(video)\"\n            :track-path=\"`/api/video/${video.slug}/share`\"\n            expanded\n          />\n        </div>\n\n        <AdSlot position=\"ARTICLE_BOTTOM\" collapse-when-empty />\n      </div>\n\n      <aside class=\"space-y-6\">\n        <SectionHeading :title=\"t('moreVideos')\" href=\"/video\" />\n        <div class=\"space-y-4\">\n          <VideoCard v-for=\"item in (more ?? []).filter(v => v.id !== video!.id)\" :key=\"item.id\" :video=\"item\" />\n        </div>\n      </aside>\n    </div>\n  </div>\n</template>\n"],"version":3}