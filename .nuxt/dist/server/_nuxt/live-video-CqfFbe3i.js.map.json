{"file":"live-video-CqfFbe3i.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAUA,UAAM,EAAE,GAAG,OAAO,WAAA,IAAe,UAAA;AACjC,UAAM,EAAE,KAAA,KAAS,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,YAA4C,cAAc,iBAAiB,CAAA;AAClG,UAAM,OAAO,SAAS,MAAM,KAAK,OAAO,QAAQ,IAAI;AAEpD,eAAW;AAAA,MACT,OAAO,KAAK,QAAQ,MAAM,EAAE,WAAW,CAAC,IAAI,WAAW,KAAK,KAAK,CAAC,KAAK,EAAE,eAAe;AAAA,MACxF,aAAa,EAAE,eAAe;AAAA,MAC9B,MAAM;AAAA,IAAA,CACP;;;;AAIM,YAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,uBAAmB,MAAA,CAAA,CAAA,qIAAA;UAIhBC,MAAA,IAAA,GAAI;;;;;+BAITA,MAAA,CAAA,EAAC,eAAA,CAAA,CAAA,OAAA;UAEMA,MAAA,IAAA,GAAI;;;;;;UAGPA,MAAA,IAAA,GAAI;6JAEoC,EAAA,gBAAA,SAAA,CAA4B,0BAEtE,OAAKA,YAAK,UAAUA,MAAA,IAAA,EAAK,aAAa,MAAS,IAC/CC,cAAA,UAAQD,MAAA,IAAA,EAAK,gBAAgB,MAAS,8HAKSE,eAAAF,MAAA,IAAA,EAAK,OAAO;AACvD,YAAAA,MAAA,IAAA,EAAK,QAAM;AAAyD,gBAAA,0DAAAE,eAAAF,MAAA,IAAA,EAAK,MAAM,CAAA,MAAA;AAAA;;;;;;;mGASnDA,MAAA,CAAA,EAAC,gBAAA,CAAA,8EAEnCA,MAAA,CAAA,EAAC,mBAAA,CAAA;;UAEI,IAAG;AAAA,UAAS,OAAM;AAAA,QAAA;2BAA5B,CAEW,GAAAG,QAAAC,UAAA,aAAA;;uCADNJ,MAAA,CAAA,EAAC,aAAA,CAAA,CAAA,EAAA;AAAA;;gDAADA,MAAA,CAAA,EAAC,aAAA,CAAA,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderAttr","_ssrInterpolate","_push","_parent"],"sources":["../../../../pages/live-video.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { VideoCard as VideoCardType } from '~/types'\n\n/**\n * Live stream page (§28).\n *\n * When nothing is on air the page says so plainly rather than showing a broken\n * player — claiming a live feed that is not running would be misleading.\n */\n\nconst { t, title: localTitle } = useLocale()\nconst { data } = await useAsyncApi<{ live: VideoCardType | null }>('live-video', '/api/live-video')\nconst live = computed(() => data.value?.live ?? null)\n\nuseSiteSeo({\n  title: live.value ? `🔴 ${t('liveColon')} ${localTitle(live.value)}` : t('liveBroadcast'),\n  description: t('liveVideoDesc'),\n  path: '/live-video',\n})\n</script>\n\n<template>\n  <div class=\"container-content\">\n    <header class=\"flex items-center gap-3 border-b-2 border-breaking pb-4\">\n      <h1 class=\"flex items-center gap-2 text-kh-2xl font-bold\">\n        <span\n          v-if=\"live\"\n          class=\"inline-block h-3 w-3 rounded-full bg-breaking animate-pulse-dot\"\n          aria-hidden=\"true\"\n        />\n        {{ t('liveBroadcast') }}\n      </h1>\n      <span v-if=\"live\" class=\"badge-breaking\">LIVE</span>\n    </header>\n\n    <div v-if=\"live\" class=\"mt-6 grid gap-8 lg:grid-cols-3\">\n      <div class=\"lg:col-span-2\">\n        <div class=\"overflow-hidden rounded-lg bg-ink\" style=\"aspect-ratio: 16 / 9\">\n          <video\n            :src=\"live.hlsUrl || live.sourceUrl || undefined\"\n            :poster=\"live.thumbnailUrl || undefined\"\n            controls autoplay muted playsinline\n            class=\"h-full w-full\"\n          />\n        </div>\n        <h2 class=\"mt-4 text-kh-xl font-bold khmer-wrap\">{{ live.titleKh }}</h2>\n        <p v-if=\"live.descKh\" class=\"mt-2 text-kh-base text-ink-muted khmer-wrap\">{{ live.descKh }}</p>\n      </div>\n\n      <aside class=\"space-y-8\">\n        <ArticleSidebarTrending />\n      </aside>\n    </div>\n\n    <div v-else class=\"py-16 text-center\">\n      <p class=\"text-kh-lg font-semibold\">{{ t('nothingLiveNow') }}</p>\n      <p class=\"mt-2 text-kh-base text-ink-muted khmer-wrap\">\n        {{ t('checkLatestVideos') }}\n      </p>\n      <NuxtLink to=\"/video\" class=\"mt-6 inline-block rounded-lg bg-brand px-5 py-2.5 font-semibold text-white hover:bg-brand-dark\">\n        {{ t('watchVideos') }}\n      </NuxtLink>\n    </div>\n  </div>\n</template>\n"],"version":3}