,KAAK,EAAE,OAAO,EAAE,GAAG,MAAM,OAAO,OAAO,MAAM,MAAM,OAAA,EAAU,CAAG;AAAA,IACzE;AAEA,YAAQ,EAAE,OAAO,uBAAuB;;;;;;;;;;mKAOCA,MAAA,CAAA,EAAC,UAAA,CAAA;UACzBA,MAAA,IAAA,GAAI;AACR,cAAA,qCAAAC,eAAAD,MAAA,CAAA,sBAAsBA,MAAA,IAAA,EAAK,QAAM,OAASA,MAAA,IAAA,EAAK,OAAK,CAAA,CAAA,MAAA;AAAA;;;;;QAGjD,IAAG;AAAA,QAAqB,OAAM;AAAA,MAAA;yBAAxC,CAEW,GAAAE,QAAAC,UAAA,aAAA;;qCADNH,MAAA,CAAA,EAAC,YAAA,CAAA,CAAA,EAAA;AAAA;;8CAADA,MAAA,CAAA,EAAC,YAAA,CAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;;AAQeI,oBAAAJ,MAAA,aAAA,IAAV,WAAM;;;UACkFA,MAAA,MAAA,MAAW,OAAO,QAAK,qCAAA;AAAA,QAAA,OAKpHC,eAAA,OAAO,KAAK;;;;oBAMHD,MAAA,MAAA;AAAA,2DAAA,OAAM,QAAA,SAAA;AAAA,QACd,aAAaA,MAAA,CAAA,EAAC,gBAAA;AAAA,QACd,MAAMA,MAAA,OAAA;AAAA,QACN,UAAQ;AAAA,QACR,qBAAO,YAAW,EAAA;AAAA,MAAA;;;QAIpB,eAAaA,MAAA,KAAA;AAAA,QACb,SAASA,MAAA,YAAA;AAAA,QACT,OAAOA,MAAA,CAAA,EAAC,SAAA;AAAA,QACT,QAAA;AAAA,QAAO,MAAK;AAAA,QACX,uBAAkB,CAAA,WAAE,SAAS,OAAO,MAAM,CAAA;AAAA,MAAA;;UAMxCA,MAAA,OAAA,GAAO;4EAA8CA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA,MAChD,WAAA,CAAAA,MAAA,IAAA,EAAK,QAAM;iFACrBA,MAAA,CAAA,EAAC,WAAA,CAAA,CAAA,MAAA;AAAA;;AAMsBI,sBAAAJ,MAAA,IAAA,IAAX,YAAO;;;YAEb,KAAK,QAAQ;AAAA,YAAW,KAAK,QAAQ,YAAQ;AAAA,YAC7C,OAAO;AAAA,YAAK,QAAQ;AAAA,YACrB,OAAM;AAAA,UAAA;;;YAIK,IAAE,eAAiB,QAAQ,EAAE;AAAA,YAAS,OAAM;AAAA,UAAA;6BAAvD,CAEW,GAAAE,QAAAC,UAAA,aAAA;;AADND,uBAAA,GAAAD,eAAAD,MAAA,YAAA,EAAa,OAAO,CAAA,CAAA,EAAA;AAAA;;kBAApBK,gBAAAC,gBAAAN,MAAA,YAAA,EAAa,OAAO,CAAA,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;YAGJ,QAAQ,QAAQ;AAAA,UAAA;AACvB,cAAA,QAAQ,UAAQ;0CAAK,QAAQ,SAAS,MAAM,CAAA,SAAA;AAAA;;;AAC5C,cAAA,QAAQ,QAAM;4CAAO,QAAQ,OAAO,MAAM,CAAA,SAAA;AAAA;;;2BAC3CC,eAAAD,MAAA,QAAA,EAAS,QAAQ,eAAe,QAAQ,SAAS,CAAA,mBACjDC,eAAA,QAAQ,SAAS,oBAAOD,MAAA,CAAA,EAAC,OAAA,CAAA;AACxB,cAAA,QAAQ,YAAU;;;;;AACT,cAAA,QAAQ,YAAU;AAAE,kBAAAO,mBAAA,0BAAA,EAAA,OAAA,MAAK,MAAA,OAAA,CAAA;AAAA;;;;AAMxC,cAAA,QAAQ,WAAM,aAAA;;cACnB,IAAE,SAAW,QAAQ,IAAI;AAAA,cAAI,QAAO;AAAA,cACrC,OAAM;AAAA,YAAA;+BAHR,CAI2B,GAAAL,QAAAC,UAAA,aAAA;;2CAAvBH,MAAA,CAAA,EAAC,MAAA,CAAA,CAAA,EAAA;AAAA;;oDAADA,MAAA,CAAA,EAAC,MAAA,CAAA,GAAA,CAAA;AAAA,kBAAA;AAAA;;;;;;;AAEG,cAAAA,MAAA,IAAA,EAAK,IAAG,aAAA,GAAA;uIAGZA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,WAAA;AAAA;;;;;;;UAQV,SAASA,MAAA,WAAA;AAAA,UACT,YAAUA,MAAA,WAAA;AAAA,UACV,QAAQA,MAAA,UAAA;AAAA,UACT,YAAA;AAAA,UACC,QAAMA,MAAA,YAAA;AAAA,QAAA;;;;QAKR,QAAQA,MAAA,aAAA;AAAA,QACR,OAAOA,MAAA,CAAA,EAAC,oBAAA;AAAA,QACR,SAASA,MAAA,aAAA,IAAgBA,MAAA,YAAA,EAAaA,MAAA,aAAA,CAAa,IAAA;AAAA,QACnD,gBAAcA,MAAA,aAAA,GAAe,oCAAoC;AAAA,QACjE,cAAc;AAAA;;;;QAKd,iBAAeA,MAAA,CAAA,EAAC,QAAA;AAAA,QAChB,MAAMA,MAAA,QAAA;AAAA,QACN,WAAS;AAAA,QACT,sBAAQ,cAAA,QAAa;AAAA,MAAA;UAEfA,MAAA,WAAA,GAAW;oGAAsEA,MAAA,WAAA,CAAW,CAAA,MAAA;AAAA;;;;;;;;;;;;;","names":["_unref","_ssrInterpolate","_push","_parent","_ssrRenderList","_createTextVNode","_toDisplayString","_ssrRenderComponent"],"sources":["../../../../pages/admin/news/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { ApiMeta, ArticleStatus } from '~/types'\nimport type { AdminCard } from '~/types/admin'\n\n/** Article list (§73 /admin/news) with search, page size and scroll-to-load. */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst api = useAdminApi()\nconst route = useRoute()\nconst router = useRouter()\nconst { dateTime } = useFormat()\nconst { t, locale, contentTitle } = useAdminLocale()\nconst { meta: platformMeta, toOptions } = useMeta()\nconst auth = useAuthStore()\n\nconst pendingDelete = ref<AdminCard | null>(null)\nconst deleting = ref(false)\nconst deleteError = ref('')\n\nconst articles = ref<AdminCard[]>([])\nconst meta = ref<ApiMeta | null>(null)\nconst loading = ref(true)\n\nconst search = ref(String(route.query.search ?? ''))\nconst status = computed(() => String(route.query.status ?? ''))\nconst limit = computed(() => Number(route.query.limit) || 25)\n\n// Statuses come from /api/meta, derived from the same constants the API\n// validates against — so a workflow change cannot leave a filter offering a\n// status the backend would reject.\nconst statusOptions = computed(() => [\n  { value: '', label: t('all') },\n  ...toOptions(platformMeta.value?.articleStatuses, locale.value),\n])\n\nconst limitOptions = [25, 50, 100].map(n => ({ value: n, label: String(n) }))\n\nasync function confirmDelete() {\n  if (!pendingDelete.value) return\n  deleting.value = true\n  deleteError.value = ''\n  try {\n    await api.del(`/api/news/${pendingDelete.value.id}`)\n    pendingDelete.value = null\n    await load()\n  } catch (e: unknown) {\n    deleteError.value = (e as { data?: { message?: string } }).data?.message || 'Could not delete the article.'\n  } finally {\n    deleting.value = false\n  }\n}\n\nfunction query(page: number) {\n  return {\n    status: status.value || undefined,\n    search: String(route.query.search ?? '') || undefined,\n    page,\n    limit: limit.value,\n  }\n}\n\n/** Loads the first page. Any filter change starts over from here. */\nasync function load() {\n  loading.value = true\n  try {\n    const result = await api.list<AdminCard[]>('/api/admin/news', query(1))\n    articles.value = result.data ?? []\n    meta.value = result.meta ?? null\n    resetFeed(result.meta)\n  } finally {\n    loading.value = false\n  }\n}\n\nconst {\n  extra: extraArticles,\n  loading: feedLoading,\n  hasMore: feedHasMore,\n  failed: feedFailed,\n  sentinel,\n  next: loadNextPage,\n  reset: resetFeed,\n} = usePagedFeed<AdminCard>(\n  async (page) => {\n    const result = await api.list<AdminCard[]>('/api/admin/news', query(page))\n    return { data: result.data ?? [], meta: result.meta }\n  },\n  { meta: null },\n)\n\nconst rows = computed(() => [...articles.value, ...extraArticles.value])\n\nonMounted(load)\nwatch(() => route.query, load)\n\n// SearchInput owns the debounce, so every search box on the platform behaves\n// the same way.\nfunction applySearch(value: string) {\n  router.push({ query: { ...route.query, search: value || undefined, page: undefined } })\n}\n\nfunction setStatus(next: string) {\n  router.push({ query: { ...route.query, status: next || undefined, page: undefined } })\n}\n\nfunction setLimit(next: number) {\n  router.push({ query: { ...route.query, limit: next, page: undefined } })\n}\n\nuseHead({ title: 'Articles — Newsroom' })\n</script>\n\n<template>\n  <div>\n    <div class=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\n      <div>\n        <h1 class=\"text-xl font-bold\">{{ t('articles') }}</h1>\n        <p v-if=\"meta\" class=\"text-sm text-ink-muted\">\n          {{ t('showing', { shown: rows.length, total: meta.total }) }}\n        </p>\n      </div>\n      <NuxtLink to=\"/admin/news/create\" class=\"rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-dark\">\n        {{ t('newArticle') }}\n      </NuxtLink>\n    </div>\n\n    <!-- ── Filters ───────────────────────────────────────────────────── -->\n    <div class=\"mb-4 space-y-3\">\n      <div class=\"flex flex-wrap items-center gap-2\">\n        <button\n          v-for=\"option in statusOptions\" :key=\"option.value\"\n          :class=\"[\n            'rounded-full border px-3 py-1.5 text-sm transition-colors',\n            status === option.value ? 'border-brand bg-brand text-white' : 'border-line hover:border-brand',\n          ]\"\n          @click=\"setStatus(option.value)\"\n        >{{ option.label }}</button>\n      </div>\n\n      <div class=\"flex flex-wrap items-center gap-3\">\n        <div class=\"min-w-[16rem] flex-1\">\n          <SearchInput\n            v-model=\"search\"\n            :placeholder=\"t('searchArticles')\"\n            :busy=\"loading\"\n            @search=\"applySearch\"\n            @clear=\"applySearch('')\"\n          />\n        </div>\n        <SelectField\n          :model-value=\"limit\"\n          :options=\"limitOptions\"\n          :label=\"t('perPage')\"\n          inline size=\"sm\"\n          @update:model-value=\"setLimit(Number($event))\"\n        />\n      </div>\n    </div>\n\n    <!-- ── Results ───────────────────────────────────────────────────── -->\n    <p v-if=\"loading\" class=\"py-12 text-center text-ink-muted\">{{ t('loading') }}</p>\n    <p v-else-if=\"!rows.length\" class=\"card py-12 text-center text-ink-muted\">\n      {{ t('noResults') }}\n    </p>\n\n    <template v-else>\n      <div class=\"card overflow-hidden\">\n        <ul class=\"divide-y divide-line\">\n          <li v-for=\"article in rows\" :key=\"article.id\" class=\"flex items-start gap-3 p-4 hover:bg-surface-muted\">\n            <SmartImage\n              :src=\"article.imageUrl\" :alt=\"article.imageAlt || ''\"\n              :width=\"64\" :height=\"36\"\n              class=\"h-9 w-16 shrink-0 rounded\"\n            />\n\n            <div class=\"min-w-0 flex-1\">\n              <NuxtLink :to=\"`/admin/news/${article.id}/edit`\" class=\"block truncate text-kh-sm font-semibold hover:text-brand\">\n                {{ contentTitle(article) }}\n              </NuxtLink>\n              <div class=\"mt-1 flex flex-wrap items-center gap-2 text-xs text-ink-muted\">\n                <AdminStatusBadge :status=\"article.status\" />\n                <span v-if=\"article.category\">{{ article.category.nameKh }}</span>\n                <span v-if=\"article.author\">· {{ article.author.nameKh }}</span>\n                <span>· {{ dateTime(article.publishedAt || article.updatedAt) }}</span>\n                <span>· {{ article.wordCount }} {{ t('words') }}</span>\n                <span v-if=\"article.aiAssisted\" class=\"rounded bg-brand/10 px-1.5 py-0.5 text-brand\">AI draft</span>\n                <BreakingBadge v-if=\"article.isBreaking\" small />\n              </div>\n            </div>\n\n            <div class=\"flex shrink-0 gap-1.5\">\n              <NuxtLink\n                v-if=\"article.status === 'published'\"\n                :to=\"`/news/${article.slug}`\" target=\"_blank\"\n                class=\"rounded border border-line px-2 py-1 text-xs hover:bg-surface\"\n              >{{ t('view') }}</NuxtLink>\n              <button\n                v-if=\"auth.can('news.delete')\"\n                class=\"rounded border border-breaking px-2 py-1 text-xs text-breaking hover:bg-breaking/5\"\n                @click=\"pendingDelete = article\"\n              >{{ t('remove') }}</button>\n            </div>\n          </li>\n        </ul>\n      </div>\n\n      <div ref=\"sentinel\" aria-hidden=\"true\" />\n      <InfiniteFooter\n        :loading=\"feedLoading\"\n        :has-more=\"feedHasMore\"\n        :failed=\"feedFailed\"\n        show-end\n        @next=\"loadNextPage\"\n      />\n    </template>\n\n    <ConfirmDialog\n      :open=\"!!pendingDelete\"\n      :title=\"t('confirmDeleteTitle')\"\n      :message=\"pendingDelete ? contentTitle(pendingDelete) : ''\"\n      :require-text=\"pendingDelete?.status === 'published' ? 'DELETE' : undefined\"\n      :consequences=\"[\n        'The article is removed from the site, feeds and sitemaps.',\n        'Existing links to it will stop working — add a redirect if it was published.',\n        'The record is retired, not destroyed, and stays in the audit log.',\n      ]\"\n      :confirm-label=\"t('remove')\"\n      :busy=\"deleting\"\n      @confirm=\"confirmDelete\"\n      @cancel=\"pendingDelete = null\"\n    />\n    <p v-if=\"deleteError\" class=\"mt-3 rounded-lg bg-breaking/10 p-3 text-sm text-breaking\">{{ deleteError }}</p>\n  </div>\n</template>\n"],"version":3}