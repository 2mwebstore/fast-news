{"file":"audit-logs-S9wVcWX_.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAgBA,UAAM,EAAE,EAAA,IAAM,eAAA;AAEd,UAAM,MAAM,YAAA;AACZ,UAAM,EAAE,SAAA,IAAa,UAAA;AAoBrB,UAAM,OAAO,aAAA;AACb,UAAM,QAAQ,SAAA;AACd,UAAM,SAAS,UAAA;AAIf,UAAM,OAAO,SAAS,MAAM,KAAK,IAAI,GAAG,OAAO,MAAM,MAAM,IAAI,KAAK,CAAC,CAAC;AACtE,UAAM,QAAQ,SAAS,MAAM;AAC3B,YAAM,QAAQ,OAAO,MAAM,MAAM,KAAK,KAAK;AAC3C,aAAO,CAAC,IAAI,IAAI,GAAG,EAAE,SAAS,KAAK,IAAI,QAAQ;AAAA,IACjD,CAAC;AACD,UAAM,eAAe,CAAC,IAAI,IAAI,GAAG,EAAE,IAAI,CAAA,OAAM,EAAE,OAAO,GAAG,OAAO,OAAO,CAAC,IAAI;AAE5E,UAAM,OAAO,IAAoB,IAAI;AACrC,UAAM,UAAU,IAAa,EAAE;AAC/B,UAAM,YAAY,IAAsB,IAAI;AAC5C,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,SAAS,IAAI,EAAE;AACrB,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,UAAU,IAA4B,IAAI;AAEhD,UAAM,WAAW,SAAS,MAAM,KAAK,IAAI,cAAc,CAAC;AAExD,mBAAe,OAAO;AACpB,cAAQ,QAAQ;AAChB,UAAI;AACF,cAAM,CAAC,QAAQ,KAAK,IAAI,MAAM,QAAQ,IAAI;AAAA,UACxC,IAAI,KAAc,yBAAyB,EAAE,MAAM,KAAK,OAAO,OAAO,MAAM,OAAO;AAAA,UACnF,IAAI,IAAe,iCAAiC,EAAE,MAAM,MAAM,IAAI;AAAA,QAAA,CACvE;AACD,gBAAQ,QAAQ,OAAO,QAAQ,CAAA;AAC/B,aAAK,QAAQ,OAAO,QAAQ;AAC5B,kBAAU,QAAQ;AAAA,MACpB,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAKA,UAAM,CAAC,MAAM,KAAK,GAAG,IAAI;AAGzB,UAAM,cAAc,SAAS,MAAM;AACjC,UAAI,CAAC,KAAK,MAAO,QAAO,CAAA;AACxB,YAAM,EAAE,MAAM,SAAS,WAAA,IAAe,KAAK;AAC3C,YAAM,QAAQ,KAAK,IAAI,GAAG,UAAU,CAAC;AACrC,YAAM,MAAM,KAAK,IAAI,YAAY,UAAU,CAAC;AAC5C,aAAO,MAAM,KAAK,EAAE,QAAQ,MAAM,QAAQ,EAAA,GAAK,CAAC,GAAG,MAAM,QAAQ,CAAC;AAAA,IACpE,CAAC;AAED,aAAS,OAAO,QAAgB;AAC9B,aAAO;AAAA,QACL,MAAM;AAAA,QACN,OAAO;AAAA,UACL,GAAG,MAAM;AAAA,UACT,MAAM,WAAW,IAAI,SAAY;AAAA,UACjC,OAAO,MAAM,UAAU,KAAK,SAAY,MAAM;AAAA,QAAA;AAAA,MAChD;AAAA,IAEJ;AAEA,aAAS,SAAS,MAAuB;AAGvC,aAAO,KAAK,EAAE,MAAM,qBAAqB,OAAO,EAAE,GAAG,MAAM,OAAO,OAAO,OAAO,IAAI,GAAG,MAAM,OAAA,GAAa;AAAA,IAC5G;AAEA,mBAAe,QAAQ;AACrB,YAAM,SAAS,QAAQ;AACvB,UAAI,CAAC,OAAQ;AACb,cAAQ,QAAQ;AAChB,mBAAa,QAAQ;AACrB,UAAI;AACF,cAAM,SAAS,MAAM,IAAI;AAAA,UACvB,gCAAgC,OAAO,MAAM;AAAA,QAAA;AAE/C,eAAO,QAAQ,EAAE,aAAa,EAAE,GAAG,OAAO,SAAS;AACnD,gBAAQ,QAAQ;AAGhB,YAAI,KAAK,QAAQ,GAAG;AAClB,gBAAM,OAAO,KAAK,OAAO,CAAC,CAAC;AAAA,QAC7B,OAAO;AACL,gBAAM,KAAA;AAAA,QACR;AAAA,MACF,SAAS,GAAY;AACnB,qBAAa,QAAS,EAAsC,MAAM,WAAW,EAAE,aAAa;AAC5F,gBAAQ,QAAQ;AAAA,MAClB,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAEA,YAAQ,EAAE,OAAO,wBAAwB;;;;;+FAKCA,MAAA,CAAA,EAAC,eAAA,CAAA;UAE9BA,MAAA,MAAA,GAAM;gHAAkFA,MAAA,MAAA,CAAM,CAAA,MAAA;AAAA;;;UAC9FA,MAAA,YAAA,GAAY;iHAAmFA,MAAA,YAAA,CAAY,CAAA,MAAA;AAAA;;;AAGrG,UAAAA,MAAA,QAAA,KAAYA,MAAA,SAAA,GAAS;0FACJA,MAAA,CAAA,EAAC,WAAA,CAAA,yEACqBA,MAAA,CAAA,EAAC,gBAAA,CAAA,8DAGhDA,MAAA,CAAA,EAAC,gBAAA,EAAA,GAAsBA,MAAA,SAAA,EAAU,MAAA,CAAK,CAAA;AACzB,YAAAA,MAAA,SAAA,EAAU,QAAM;6CAAQA,MAAA,CAAA,EAAC,aAAA,CAAA,oBAAsBA,MAAA,QAAA,EAASA,MAAA,SAAA,EAAU,MAAM,CAAA;;;;;sBAK1EA,MAAA,SAAA,EAAU,SAAO,CAAtB,MAAC;uKAIGA,MAAA,OAAA,KAAW,EAAE,cAAS,CAAA,IAAA,cAAA,wCAGIC,eAAA,EAAE,KAAK,qEAEvC,EAAE,YAAS,IAAOD,MAAA,CAAA,sBAAsB,EAAE,UAAA,CAAS,IAAMA,MAAA,CAAA,EAAC,cAAA,CAAA;;;;;;UAM1DA,MAAA,IAAA,GAAI;AAER,cAAA,yGAAAC,eAAAD,MAAA,CAAA,sBAAsBA,MAAA,OAAA,EAAQ,QAAM,OAASA,MAAA,IAAA,EAAK,OAAK,CAAA,CAAA,GAAA;AAC9C,YAAAA,MAAA,IAAA,EAAK,aAAU,GAAA;AAAW,gBAAA,WAAAC,eAAAD,MAAA,CAAA,oBAAoBA,MAAA,IAAA,EAAK,MAAI,OAASA,MAAA,IAAA,EAAK,YAAU,CAAA,CAAA,SAAA;AAAA;;;;;UAG1F,eAAaA,MAAA,KAAA;AAAA,UACb,SAASA,MAAA,YAAA;AAAA,UACT,OAAOA,MAAA,CAAA,EAAC,SAAA;AAAA,UACT,QAAA;AAAA,UACA,MAAK;AAAA,UACJ,uBAAkB,CAAA,WAAE,SAAS,MAAM;AAAA,QAAA;;;;;UAI/BA,MAAA,OAAA,GAAO;4EAA8CA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA,MAChD,WAAA,CAAAA,MAAA,OAAA,EAAQ,QAAM;iFAAmDA,MAAA,CAAA,EAAC,gBAAA,CAAA,CAAA,MAAA;AAAA;0NAMhDA,MAAA,CAAA,EAAC,SAAA,CAAA,8CACDA,MAAA,CAAA,EAAC,SAAA,CAAA,8CACDA,MAAA,CAAA,EAAC,WAAA,CAAA,8CACDA,MAAA,CAAA,EAAC,YAAA,CAAA;AAIRE,sBAAAF,MAAA,OAAA,IAAT,UAAK;qGACoDA,MAAA,QAAA,EAAS,MAAM,SAAS,CAAA,uCACzDC,eAAA,MAAM,aAAS,GAAA,qDACDA,eAAA,MAAM,MAAM,gFACP,SAAO,MAAM,OAAO,KAAKA,eAAA,MAAM,OAAO;;;;UAc1FD,MAAA,IAAA,KAAQA,MAAA,IAAA,EAAK,aAAU,GAAA;AAE5B,cAAA,qEAAAG,cAAA,cAAYH,MAAA,CAAA,EAAC,YAAA,CAAA,CAAA,GAAA;AAEE,YAAAA,MAAA,IAAA,EAAK,OAAI,GAAA;;YAAmC,IAAI,OAAOA,MAAA,IAAA,EAAK,OAAI,CAAA;AAAA,YAAO,QAAA;AAAA,UAAA;6BAAvF,CAMW,EAAA,MAAA,SAAA,GAAAI,QAAAC,UAAA,aAAA;;0CAJN,QAAM,QAAQ,MAAS,4HAGpBL,MAAA,CAAA,EAAC,UAAA,CAAA;;;kBAJPM,YAI0B,KAAA;AAAA,oBAHvB,MAAM,QAAQ;AAAA,oBACf,OAAM;AAAA,oBACL,SAAO;AAAA,kBAAA,GACT,uBAAKN,MAAA,CAAA,EAAC,UAAA,CAAA,GAAA,GAAA,CAAA,QAAA,SAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;YAGOA,MAAA,WAAA,EAAW,CAAA,IAAA,GAAA;;YAAsC,IAAI,OAAM,CAAA;AAAA,YAAK,QAAA;AAAA,UAAA;6BAAhF,CAEW,EAAA,MAAA,SAAA,GAAAI,QAAAC,UAAA,aAAA;;0CADL,QAAM,QAAQ,MAAS;;;kBAA3BC,YAA+G,KAAA;AAAA,oBAA3G,MAAM,QAAQ;AAAA,oBAAW,OAAM;AAAA,oBAAsD,SAAO;AAAA,kBAAA,GAAU,KAAC,GAAA,CAAA,QAAA,SAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;YAEjGN,MAAA,WAAA,EAAW,CAAA,IAAA,GAAA;;;;;;AAGTE,sBAAAF,MAAA,WAAA,IAAL,MAAC;;YACP,KAAK;AAAA,YAEL,IAAI,OAAO,CAAC;AAAA,YACb,QAAA;AAAA,UAAA;6BALF,CAgBW,EAAA,MAAA,SAAA,GAAAI,QAAAC,UAAA,aAAA;;0CARN,QAAM,QAAQ,MAAS;;kBACsD,MAAML,MAAA,IAAA,EAAK,OAAI,sCAAA;AAAA,gBAAA,MAI5FG,cAAA,gBAAc,MAAMH,YAAK,gBAAgB,MAAS,+BAEjD,CAAC;;;kBARLM,YAQY,KAAA;AAAA,oBAPT,MAAM,QAAQ;AAAA,oBACd,OAAK;AAAA;sBAAwE,MAAMN,MAAA,IAAA,EAAK,OAAI,sCAAA;AAAA,oBAAA;AAAA,oBAI5F,gBAAc,MAAMA,YAAK,gBAAgB;AAAA,oBACzC,SAAO;AAAA,kBAAA,mBACN,CAAC,GAAA,IAAA,CAAA,QAAA,gBAAA,SAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;AAGK,YAAAA,MAAA,WAAA,EAAYA,MAAA,WAAA,EAAY,SAAM,CAAA,IAAQA,MAAA,IAAA,EAAK,aAAU,GAAA;;;;;AAEzD,YAAAA,MAAA,WAAA,EAAYA,MAAA,WAAA,EAAY,SAAM,CAAA,IAAQA,MAAA,IAAA,EAAK,YAAU;;YAE1D,IAAI,OAAOA,MAAA,IAAA,EAAK,UAAU;AAAA,YAC3B,QAAA;AAAA,UAAA;6BAJF,CAOW,EAAA,MAAA,SAAA,GAAAI,QAAAC,UAAA,aAAA;;0CADL,QAAM,QAAQ,MAAS,2EAAkFJ,eAAAD,MAAA,IAAA,EAAK,UAAU;;;kBAA5HM,YAAmI,KAAA;AAAA,oBAA/H,MAAM,QAAQ;AAAA,oBAAW,OAAM;AAAA,oBAAsD,SAAO;AAAA,kBAAA,GAAaC,gBAAAP,MAAA,IAAA,EAAK,UAAU,GAAA,GAAA,CAAA,QAAA,SAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;AAG9G,YAAAA,MAAA,IAAA,EAAK,SAAO;;YAA+B,IAAI,OAAOA,MAAA,IAAA,EAAK,OAAI,CAAA;AAAA,YAAO,QAAA;AAAA,UAAA;6BAAtF,CAMW,EAAA,MAAA,SAAA,GAAAI,QAAAC,UAAA,aAAA;;0CAJN,QAAM,QAAQ,MAAS,0HAGtBL,MAAA,CAAA,EAAC,MAAA,CAAA;;;kBAJLM,YAIsB,KAAA;AAAA,oBAHnB,MAAM,QAAQ;AAAA,oBACf,OAAM;AAAA,oBACL,SAAO;AAAA,kBAAA,GACNC,gBAAAP,MAAA,CAAA,aAAY,MAAE,GAAA,CAAA,QAAA,SAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;;;;;;QAKnB,QAAQA,MAAA,OAAA;AAAA,QACR,OAAOA,MAAA,CAAA,EAAC,YAAA;AAAA,QACR,SAASA,MAAA,OAAA,IAAUA,MAAA,CAAA,EAAC,gBAAA,EAAA,QAA2BA,MAAA,OAAA,EAAQ,QAAM,GAAKA,MAAA,OAAA,EAAQ,UAAA,CAAS,IAAA;AAAA,QACnF,iBAAeA,MAAA,CAAA,EAAC,OAAA;AAAA,QAChB,gBAAcA,MAAA,CAAA,EAAC,QAAA;AAAA,QACf,MAAMA,MAAA,OAAA;AAAA,QACN,WAAS;AAAA,QACT,sBAAQ,QAAA,QAAO;AAAA,MAAA;;;;;;;;;;;","names":["_unref","_ssrInterpolate","_ssrRenderList","_ssrRenderAttr","_push","_parent","_createVNode","_toDisplayString"],"sources":["../../../../pages/admin/audit-logs.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { ApiMeta } from '~/types'\n\n/**\n * Audit log (§66, §79), with retention.\n *\n * Trimming the log is the one action that removes the record of other actions,\n * so it needs roles.manage — Super Admin only, the same gate as editing what a\n * role can do — and the purge records itself before deleting anything. A log\n * that could be silently shortened would not be an audit log.\n *\n * The windows are fixed at 1, 2 and 3 months rather than a free date, because a\n * free date lets somebody delete yesterday.\n */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst { t } = useAdminLocale()\n\nconst api = useAdminApi()\nconst { dateTime } = useFormat()\n\ninterface Entry {\n  id: number; createdAt: string; userEmail: string\n  action: string; entityType: string; entityId?: number\n  summary: string; ipAddress: string\n}\n\ninterface RetentionWindow {\n  months: number\n  label: string\n  cutoff: string\n  removable: number\n}\ninterface Retention {\n  total: number\n  oldest?: string\n  windows: RetentionWindow[]\n}\n\nconst auth = useAuthStore()\nconst route = useRoute()\nconst router = useRouter()\n\n// Page and size live in the URL, so a page of the log is linkable and survives\n// a reload — which matters when somebody is citing an entry to a colleague.\nconst page = computed(() => Math.max(1, Number(route.query.page) || 1))\nconst limit = computed(() => {\n  const value = Number(route.query.limit) || 50\n  return [25, 50, 100].includes(value) ? value : 50\n})\nconst limitOptions = [25, 50, 100].map(n => ({ value: n, label: String(n) }))\n\nconst meta = ref<ApiMeta | null>(null)\nconst entries = ref<Entry[]>([])\nconst retention = ref<Retention | null>(null)\nconst loading = ref(true)\nconst purging = ref(false)\nconst notice = ref('')\nconst errorMessage = ref('')\nconst pending = ref<RetentionWindow | null>(null)\n\nconst canPurge = computed(() => auth.can('roles.manage'))\n\nasync function load() {\n  loading.value = true\n  try {\n    const [result, stats] = await Promise.all([\n      api.list<Entry[]>('/api/admin/audit-logs', { page: page.value, limit: limit.value }),\n      api.get<Retention>('/api/admin/audit-logs/retention').catch(() => null),\n    ])\n    entries.value = result.data ?? []\n    meta.value = result.meta ?? null\n    retention.value = stats\n  } finally {\n    loading.value = false\n  }\n}\nonMounted(load)\n\n// Reloads when the page or size changes. immediate is off: onMounted already did\n// the first fetch, and running both would double-request on load.\nwatch([page, limit], load)\n\n/** A window around the current page — 40 pages of log should not render 40 links. */\nconst pageNumbers = computed(() => {\n  if (!meta.value) return []\n  const { page: current, totalPages } = meta.value\n  const start = Math.max(1, current - 2)\n  const end = Math.min(totalPages, current + 2)\n  return Array.from({ length: end - start + 1 }, (_, i) => start + i)\n})\n\nfunction linkTo(target: number) {\n  return {\n    path: '/admin/audit-logs',\n    query: {\n      ...route.query,\n      page: target === 1 ? undefined : target,\n      limit: limit.value === 50 ? undefined : limit.value,\n    },\n  }\n}\n\nfunction setLimit(next: string | number) {\n  // Back to page 1: page 7 of a 25-per-page list is not page 7 of a 100-per-page\n  // one, and landing on an empty page would look like the log had been trimmed.\n  router.push({ path: '/admin/audit-logs', query: { ...route.query, limit: Number(next), page: undefined } })\n}\n\nasync function purge() {\n  const window = pending.value\n  if (!window) return\n  purging.value = true\n  errorMessage.value = ''\n  try {\n    const result = await api.del<{ removed: number }>(\n      `/api/admin/audit-logs?months=${window.months}`,\n    )\n    notice.value = t('purgeDone', { n: result.removed })\n    pending.value = null\n    // A purge can shorten the log past the page being viewed, so go back to the\n    // first page rather than showing an empty table.\n    if (page.value > 1) {\n      await router.push(linkTo(1))\n    } else {\n      await load()\n    }\n  } catch (e: unknown) {\n    errorMessage.value = (e as { data?: { message?: string } }).data?.message || t('purgeFailed')\n    pending.value = null\n  } finally {\n    purging.value = false\n  }\n}\n\nuseHead({ title: 'Audit log — Newsroom' })\n</script>\n\n<template>\n  <div>\n    <h1 class=\"mb-4 text-xl font-bold\">{{ t('auditLogTitle') }}</h1>\n\n    <p v-if=\"notice\" role=\"status\" class=\"mb-4 rounded-lg bg-success/10 p-3 text-sm text-success\">{{ notice }}</p>\n    <p v-if=\"errorMessage\" role=\"alert\" class=\"mb-4 rounded-lg bg-breaking/10 p-3 text-sm text-breaking\">{{ errorMessage }}</p>\n\n    <!-- ── Retention ─────────────────────────────────────────────────── -->\n    <section v-if=\"canPurge && retention\" class=\"card mb-6 p-5\">\n      <h2 class=\"mb-1 font-bold\">{{ t('retention') }}</h2>\n      <p class=\"mb-3 max-w-2xl text-sm text-ink-muted\">{{ t('retentionIntro') }}</p>\n\n      <p class=\"mb-3 text-xs text-ink-muted\">\n        {{ t('entriesTotal', { n: retention.total }) }}\n        <template v-if=\"retention.oldest\"> · {{ t('oldestEntry') }} {{ dateTime(retention.oldest) }}</template>\n      </p>\n\n      <div class=\"flex flex-wrap gap-2\">\n        <button\n          v-for=\"w in retention.windows\"\n          :key=\"w.months\"\n          type=\"button\"\n          class=\"rounded-lg border border-line px-3 py-2 text-left text-sm hover:border-brand disabled:opacity-40\"\n          :disabled=\"purging || w.removable === 0\"\n          @click=\"pending = w\"\n        >\n          <span class=\"block font-semibold\">{{ w.label }}</span>\n          <span class=\"block text-xs text-ink-muted\">\n            {{ w.removable > 0 ? t('wouldRemove', { n: w.removable }) : t('purgeNothing') }}\n          </span>\n        </button>\n      </div>\n    </section>\n\n    <div v-if=\"meta\" class=\"mb-3 flex flex-wrap items-center justify-between gap-3\">\n      <p class=\"text-sm text-ink-muted\">\n        {{ t('showing', { shown: entries.length, total: meta.total }) }}\n        <span v-if=\"meta.totalPages > 1\">· {{ t('pageOf', { page: meta.page, total: meta.totalPages }) }}</span>\n      </p>\n      <SelectField\n        :model-value=\"limit\"\n        :options=\"limitOptions\"\n        :label=\"t('perPage')\"\n        inline\n        size=\"sm\"\n        @update:model-value=\"setLimit($event)\"\n      />\n    </div>\n\n    <p v-if=\"loading\" class=\"py-12 text-center text-ink-muted\">{{ t('loading') }}</p>\n    <p v-else-if=\"!entries.length\" class=\"card py-12 text-center text-ink-muted\">{{ t('noAuditEntries') }}</p>\n\n    <div v-else class=\"card overflow-x-auto\">\n      <table class=\"w-full text-sm\">\n        <thead class=\"border-b border-line bg-surface-muted text-left text-xs uppercase text-ink-muted\">\n          <tr>\n            <th class=\"px-4 py-2\">{{ t('colTime') }}</th>\n            <th class=\"px-4 py-2\">{{ t('colUser') }}</th>\n            <th class=\"px-4 py-2\">{{ t('colAction') }}</th>\n            <th class=\"px-4 py-2\">{{ t('colDetails') }}</th>\n          </tr>\n        </thead>\n        <tbody class=\"divide-y divide-line\">\n          <tr v-for=\"entry in entries\" :key=\"entry.id\">\n            <td class=\"whitespace-nowrap px-4 py-2 text-xs text-ink-muted\">{{ dateTime(entry.createdAt) }}</td>\n            <td class=\"px-4 py-2 text-xs\">{{ entry.userEmail || '—' }}</td>\n            <td class=\"px-4 py-2\"><code class=\"text-xs\">{{ entry.action }}</code></td>\n            <td class=\"max-w-md truncate px-4 py-2 text-kh-sm\" :title=\"entry.summary\">{{ entry.summary }}</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- Real links, not buttons: an entry can be cited by URL and a page opened\n         in a new tab.\n         NuxtLink is used in `custom` mode throughout. Its automatic\n         aria-current comes from Vue Router's exact-match test, which compares\n         path and params but not the query string — and these links differ only\n         by ?page=. Left alone, every link in the pager is announced as the\n         current page. -->\n    <nav\n      v-if=\"meta && meta.totalPages > 1\"\n      class=\"mt-6 flex flex-wrap items-center justify-center gap-1\"\n      :aria-label=\"t('pagination')\"\n    >\n      <NuxtLink v-if=\"meta.page > 1\" v-slot=\"{ href, navigate }\" :to=\"linkTo(meta.page - 1)\" custom>\n        <a\n          :href=\"href ?? undefined\"\n          class=\"rounded-lg border border-line px-3 py-1.5 text-sm font-semibold hover:border-brand\"\n          @click=\"navigate\"\n        >← {{ t('previous') }}</a>\n      </NuxtLink>\n\n      <NuxtLink v-if=\"pageNumbers[0] > 1\" v-slot=\"{ href, navigate }\" :to=\"linkTo(1)\" custom>\n        <a :href=\"href ?? undefined\" class=\"rounded px-3 py-1.5 text-sm hover:bg-surface-muted\" @click=\"navigate\">1</a>\n      </NuxtLink>\n      <span v-if=\"pageNumbers[0] > 2\" class=\"px-1 text-sm text-ink-muted\">…</span>\n\n      <NuxtLink\n        v-for=\"n in pageNumbers\"\n        :key=\"n\"\n        v-slot=\"{ href, navigate }\"\n        :to=\"linkTo(n)\"\n        custom\n      >\n        <a\n          :href=\"href ?? undefined\"\n          :class=\"[\n            'rounded px-3 py-1.5 text-sm tabular-nums',\n            n === meta.page ? 'bg-brand font-semibold text-white' : 'hover:bg-surface-muted',\n          ]\"\n          :aria-current=\"n === meta.page ? 'page' : undefined\"\n          @click=\"navigate\"\n        >{{ n }}</a>\n      </NuxtLink>\n\n      <span v-if=\"pageNumbers[pageNumbers.length - 1] < meta.totalPages - 1\" class=\"px-1 text-sm text-ink-muted\">…</span>\n      <NuxtLink\n        v-if=\"pageNumbers[pageNumbers.length - 1] < meta.totalPages\"\n        v-slot=\"{ href, navigate }\"\n        :to=\"linkTo(meta.totalPages)\"\n        custom\n      >\n        <a :href=\"href ?? undefined\" class=\"rounded px-3 py-1.5 text-sm hover:bg-surface-muted\" @click=\"navigate\">{{ meta.totalPages }}</a>\n      </NuxtLink>\n\n      <NuxtLink v-if=\"meta.hasMore\" v-slot=\"{ href, navigate }\" :to=\"linkTo(meta.page + 1)\" custom>\n        <a\n          :href=\"href ?? undefined\"\n          class=\"rounded-lg border border-line px-3 py-1.5 text-sm font-semibold hover:border-brand\"\n          @click=\"navigate\"\n        >{{ t('next') }} →</a>\n      </NuxtLink>\n    </nav>\n\n    <ConfirmDialog\n      :open=\"!!pending\"\n      :title=\"t('purgeTitle')\"\n      :message=\"pending ? t('purgeMessage', { months: pending.months, n: pending.removable }) : ''\"\n      :confirm-label=\"t('purge')\"\n      :cancel-label=\"t('cancel')\"\n      :busy=\"purging\"\n      @confirm=\"purge\"\n      @cancel=\"pending = null\"\n    />\n  </div>\n</template>\n"],"version":3}