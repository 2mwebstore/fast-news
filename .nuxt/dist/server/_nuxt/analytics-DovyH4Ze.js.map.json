{"file":"analytics-DovyH4Ze.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;AAIA,UAAM,EAAE,EAAA,IAAM,eAAA;AAEd,UAAM,MAAM,YAAA;AACZ,UAAM,EAAE,QAAA,IAAY,UAAA;AAUpB,UAAM,OAAO,IAAsB,IAAI;AACvC,UAAM,OAAO,IAAI,CAAC;AAClB,UAAM,UAAU,IAAI,IAAI;AAExB,mBAAe,OAAO;AACpB,cAAQ,QAAQ;AAChB,UAAI;AACF,aAAK,QAAQ,MAAM,IAAI,IAAe,wBAAwB,EAAE,MAAM,KAAK,OAAO;AAAA,MACpF,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAEA,UAAM,MAAM,IAAI;AAGhB,UAAM,OAAO,SAAS,MAAM,KAAK,IAAI,GAAG,IAAI,KAAK,OAAO,SAAS,CAAA,GAAI,IAAI,OAAK,EAAE,KAAK,CAAC,CAAC;AAEvF,YAAQ,EAAE,OAAO,wBAAwB;;;8JAMFA,MAAA,CAAA,EAAC,WAAA,CAAA;AAGlBC,oBAAA,CAAA,GAAA,GAAA,EAAA,IAAL,MAAC;gCAC4CC,eAAA,CAAA,2CAAAF,MAAA,IAAA,MAAS,IAAC,qCAAA,aAAA,CAAA,MAE5DG,eAAA,MAAC,IAASH,MAAA,CAAA,EAAC,OAAA,IAAYA,MAAA,CAAA,eAAe,EAAA,CAAC,CAAA;;;UAItCA,MAAA,OAAA,GAAO;4EAA8CA,MAAA,CAAA,EAAC,SAAA,CAAA,CAAA,MAAA;AAAA,iBAE/CA,MAAA,IAAA,GAAI;0EACmBG,eAAAH,MAAA,IAAA,EAAK,IAAI,2HAGiCA,MAAA,CAAA,EAAC,YAAA,CAAA;sBAG3DA,MAAA,IAAA,EAAK,SAAK,CAAA,GAAA,CAAlB,QAAG;kGAEWI,eAAA,EAAA,QAAA,GAAA,KAAK,IAAG,GAAK,IAAI,QAAQJ,MAAA,IAAA,IAAI,GAAA,CAAA,IAAA,CAAA,mBACjD,SAAK,GAAK,IAAI,GAAG,KAAK,IAAI,KAAK,WAAW,IAAI,WAAW,SAAA;;;aAGpDA,MAAA,IAAA,EAAK,OAAO,QAAM;qFAAqDA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,MAAA;AAAA;;;mMAKHA,MAAA,CAAA,EAAC,aAAA,CAAA,CAAA,gDAAA;AAEhDC,sBAAAD,MAAA,IAAA,EAAK,eAAW,IAAA,CAAhC,SAAS,MAAC;8HACkC,IAAC,CAAA,CAAA,SAAA;;YAC5C,IAAE,SAAW,QAAQ,IAAI;AAAA,YAAI,QAAO;AAAA,YAAS,OAAM;AAAA,UAAA;6BAA9D,CAEW,GAAAK,QAAAC,UAAA,aAAA;;AADND,uBAAA,GAAAF,eAAA,QAAQ,OAAO,CAAA,EAAA;AAAA;;kBAAfI,gBAAAC,gBAAA,QAAQ,OAAO,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;4FAEyCR,MAAA,OAAA,EAAQ,QAAQ,KAAK,CAAA,CAAA,cAAA;AAAA;;aAG5EA,MAAA,IAAA,EAAK,aAAa,QAAM;qFAAqDA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,MAAA;AAAA;;;8IAIXA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,gDAAA;sBAEzDA,MAAA,IAAA,EAAK,UAAM,CAAA,GAAA,CAAnB,QAAG;uGACgBG,eAAA,IAAI,OAAO,oDACKA,eAAA,IAAI,KAAK;;;aAG/CH,MAAA,IAAA,EAAK,QAAQ,QAAM;qFAAqDA,MAAA,CAAA,EAAC,QAAA,CAAA,CAAA,MAAA;AAAA;;;;;;;;;;;;;;;;;","names":["_unref","_ssrRenderList","_ssrRenderClass","_ssrInterpolate","_ssrRenderStyle","_push","_parent","_createTextVNode","_toDisplayString"],"sources":["../../../../pages/admin/analytics.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/** Analytics (§43). Aggregates only — no per-visitor records exist to show. */\ndefinePageMeta({ layout: 'admin', middleware: 'admin' })\n\nconst { t } = useAdminLocale()\n\nconst api = useAdminApi()\nconst { compact } = useFormat()\n\ninterface Analytics {\n  days: number\n  daily: { day: string; views: number; uniqueViews: number }[]\n  topArticles: { slug: string; titleKh: string; views: number }[]\n  shares: { network: string; count: number }[]\n  note: string\n}\n\nconst data = ref<Analytics | null>(null)\nconst days = ref(7)\nconst loading = ref(true)\n\nasync function load() {\n  loading.value = true\n  try {\n    data.value = await api.get<Analytics>('/api/admin/analytics', { days: days.value })\n  } finally {\n    loading.value = false\n  }\n}\nonMounted(load)\nwatch(days, load)\n\n// Bars are drawn relative to the busiest day in the window.\nconst peak = computed(() => Math.max(1, ...(data.value?.daily ?? []).map(d => d.views)))\n\nuseHead({ title: 'Analytics — Newsroom' })\n</script>\n\n<template>\n  <div>\n    <div class=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\n      <h1 class=\"text-xl font-bold\">{{ t('analytics') }}</h1>\n      <div class=\"flex gap-2\">\n        <button\n          v-for=\"d in [1, 7, 30]\" :key=\"d\"\n          :class=\"['rounded-full border px-3 py-1.5 text-sm', days === d ? 'border-brand bg-brand text-white' : 'border-line']\"\n          @click=\"days = d\"\n        >{{ d === 1 ? t('today') : t('days', { n: d }) }}</button>\n      </div>\n    </div>\n\n    <p v-if=\"loading\" class=\"py-12 text-center text-ink-muted\">{{ t('loading') }}</p>\n\n    <div v-else-if=\"data\" class=\"space-y-6\">\n      <p class=\"text-xs text-ink-muted\">{{ data.note }}</p>\n\n      <section class=\"card p-5\">\n        <h2 class=\"mb-4 text-sm font-bold uppercase tracking-wide text-ink-muted\">{{ t('viewsByDay') }}</h2>\n        <div class=\"flex h-40 items-end gap-1\">\n          <div\n            v-for=\"row in (data.daily || [])\" :key=\"row.day\"\n            class=\"flex-1 rounded-t bg-brand/80 transition-all hover:bg-brand\"\n            :style=\"{ height: `${Math.max(2, (row.views / peak) * 100)}%` }\"\n            :title=\"`${row.day}: ${row.views} views, ${row.uniqueViews} unique`\"\n          />\n        </div>\n        <p v-if=\"!data.daily?.length\" class=\"py-8 text-center text-sm text-ink-muted\">{{ t('noData') }}</p>\n      </section>\n\n      <div class=\"grid gap-6 lg:grid-cols-3\">\n        <section class=\"card p-5 lg:col-span-2\">\n          <h2 class=\"mb-3 text-sm font-bold uppercase tracking-wide text-ink-muted\">{{ t('topArticles') }}</h2>\n          <ol class=\"divide-y divide-line\">\n            <li v-for=\"(article, i) in (data.topArticles || [])\" :key=\"article.slug\" class=\"flex items-center gap-3 py-2\">\n              <span class=\"w-6 text-sm font-bold text-ink-muted\">{{ i + 1 }}</span>\n              <NuxtLink :to=\"`/news/${article.slug}`\" target=\"_blank\" class=\"min-w-0 flex-1 truncate text-kh-sm hover:text-brand\">\n                {{ article.titleKh }}\n              </NuxtLink>\n              <span class=\"shrink-0 text-sm font-semibold tabular-nums\">{{ compact(article.views) }}</span>\n            </li>\n          </ol>\n          <p v-if=\"!data.topArticles?.length\" class=\"py-8 text-center text-sm text-ink-muted\">{{ t('noData') }}</p>\n        </section>\n\n        <section class=\"card p-5\">\n          <h2 class=\"mb-3 text-sm font-bold uppercase tracking-wide text-ink-muted\">{{ t('shares') }}</h2>\n          <ul class=\"divide-y divide-line\">\n            <li v-for=\"row in (data.shares || [])\" :key=\"row.network\" class=\"flex items-center justify-between py-2 text-sm\">\n              <span class=\"capitalize\">{{ row.network }}</span>\n              <span class=\"font-semibold tabular-nums\">{{ row.count }}</span>\n            </li>\n          </ul>\n          <p v-if=\"!data.shares?.length\" class=\"py-8 text-center text-sm text-ink-muted\">{{ t('noData') }}</p>\n        </section>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}